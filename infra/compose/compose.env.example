# Compose-level settings for docker-compose.prod.yml (docs/runbooks/deploy.md). Copy to
# /etc/company-ops/compose.env (root-owned, 0600) and fill in. No secrets here: secrets are files in
# OPS_SECRETS_DIR (scripts/ops/init-secrets.sh creates them).

# Release: image registry/prefix and immutable tag (git SHA or semver), never `latest`.
OPS_IMAGE_REGISTRY=ghcr.io/example-org
OPS_VERSION=0.0.0-replace-me

# Public host name (certificate subject) and ports published by the proxy.
OPS_PUBLIC_HOST=ops.example.com
OPS_HTTP_PORT=80
OPS_HTTPS_PORT=443
# Must equal https://<OPS_PUBLIC_HOST> (plus :<port> when not 443). Also in the application env file.
APP_PUBLIC_URL=https://ops.example.com

# Host paths.
OPS_APP_ENV_FILE=/etc/company-ops/app.env
OPS_SECRETS_DIR=/etc/company-ops/secrets
OPS_TLS_DIR=/etc/company-ops/tls
OPS_ACME_WEBROOT=/var/lib/company-ops/acme

# Web app: origin of S3_PUBLIC_ENDPOINT (CSP connect-src/img-src); empty when storage shares the origin.
STORAGE_PUBLIC_ORIGIN=https://files.example.com

# Keycloak: bootstrap admin name (password is the keycloak_admin_password secret) and the loopback port
# used for administration over an SSH tunnel.
KC_BOOTSTRAP_ADMIN_USERNAME=ops-admin
KC_ADMIN_TUNNEL_PORT=8090
# Only with docker-compose.prod.external-data.yml: host of the external PostgreSQL for Keycloak.
# KEYCLOAK_DB_HOST=db.internal.example.com

# Bundled PostgreSQL and Redis sizing (ignored with external data stores).
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=200
REDIS_MAXMEMORY=768mb
