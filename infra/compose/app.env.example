# Application settings for API and worker in production (docs/DEPLOYMENT.md §6). Copy to
# /etc/company-ops/app.env (root-owned, 0600). Non-secret values only: DATABASE_URL, REDIS_URL,
# OIDC_CLIENT_SECRET, APP_ENCRYPTION_KEY, S3_SECRET_ACCESS_KEY, SMTP_PASSWORD and the Jira/GitHub secrets
# are secret files wired by the Compose files (*_FILE). Do not add them here: setting both forms is
# rejected at startup. Every value is validated at startup; production refuses placeholders, plain http,
# loopback hosts, development mail catchers and Swagger.

LOG_LEVEL=info
APP_PUBLIC_URL=https://ops.example.com
CORS_ORIGINS=

# Keycloak behind the same proxy (KC_HTTP_RELATIVE_PATH=/auth).
OIDC_ISSUER=https://ops.example.com/auth/realms/company-ops
OIDC_CLIENT_ID=ops-api

# Id of the current app_encryption_key secret. Retired keys go into the app_encryption_keys_previous
# secret file as <id>:<base64> pairs, never here (docs/runbooks/secrets.md §Encryption key rotation).
APP_ENCRYPTION_KEY_ID=k1

SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
MFA_MAX_AGE_MINUTES=720

# Object storage: the operator's S3-compatible service (ADR-0008). The bucket's CORS rules must allow
# APP_PUBLIC_URL with PUT and GET and the content-type header.
S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://files.example.com
S3_REGION=eu-central-1
S3_BUCKET=company-ops
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_FORCE_PATH_STYLE=false

# Email (worker). Empty SMTP_HOST disables email; otherwise add docker-compose.prod.smtp.yml.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=
SMTP_USER=

# Jira Cloud: empty = disabled. Enable only with docker-compose.prod.jira.yml after live verification.
JIRA_OAUTH_CLIENT_ID=
# GitHub App: empty = disabled. Enable only with docker-compose.prod.github.yml after live verification.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
