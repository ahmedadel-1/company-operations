# LOCAL REHEARSAL ONLY: the stand-in object store behind its own host name, as an operator's S3 service
# would be. Host keeps the port: pre-signed URLs are signed over host:port.
server {
  listen 443 ssl;
  http2 on;
  server_name ${OPS_FILES_HOST};

  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

  client_max_body_size 30m;
  set $ops_files http://seaweedfs:8333;

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_request_buffering off;
    proxy_pass $ops_files;
  }
}
