{
  "name": "@company-ops/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:dev": "node dist/dev-seed/run.js",
    "bootstrap": "node dist/bootstrap/run.js",
    "activity:rebuild": "node dist/maintenance/rebuild-activity-run.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@company-ops/config": "workspace:*",
    "@company-ops/db": "workspace:*",
    "@company-ops/shared": "workspace:*",
    "@company-ops/validation": "workspace:*",
    "file-type": "22.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@company-ops/eslint-config": "workspace:*",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
