    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@company-ops/config": "workspace:*",
    "@company-ops/eslint-config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
