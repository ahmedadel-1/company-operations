{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  }
}
