/// Tender aggregate (ADR-0026). `number` comes from the organization's `TND` counter; the display key
/// is `TND-<year>-<number>`. Readiness counters are recomputed in the same transaction as every
/// requirement change (one formula, `engine/readiness.ts`).
model Tender {
  id                         String                  @id @default(uuid(7)) @db.Uuid
  organizationId             String                  @map("organization_id") @db.Uuid
  number                     Int
  year                       Int                     @db.SmallInt
  internalReference          String?                 @map("internal_reference")
  title                      String
  description                String?
  customerId                 String?                 @map("customer_id") @db.Uuid
  /// Counterparty name as announced (historical display); the customer record stays canonical.
  counterpartyName           String?                 @map("counterparty_name")
  relatedProjectId           String?                 @map("related_project_id") @db.Uuid
  tenderType                 TenderType              @map("tender_type")
  procurementMethod          String?                 @map("procurement_method")
  publishedAt                DateTime?               @map("published_at") @db.Timestamptz(6)
  submissionDeadlineAt       DateTime?               @map("submission_deadline_at") @db.Timestamptz(6)
  submissionDeadlineTimeZone String?                 @map("submission_deadline_time_zone")
  clarificationDeadlineAt    DateTime?               @map("clarification_deadline_at") @db.Timestamptz(6)
  estimatedValue             Decimal?                @map("estimated_value") @db.Decimal(19, 4)
  currency                   String?                 @db.Char(3)
  status                     TenderStatus            @default(DRAFT)
  bidDecision                TenderBidDecision       @default(PENDING) @map("bid_decision")
  ownerMemberId              String                  @map("owner_member_id") @db.Uuid
  technicalLeadMemberId      String?                 @map("technical_lead_member_id") @db.Uuid
  commercialLeadMemberId     String?                 @map("commercial_lead_member_id") @db.Uuid
  priority                   CommercialPriority      @default(MEDIUM)
  submissionMethod           TenderSubmissionMethod? @map("submission_method")
  submissionReference        String?                 @map("submission_reference")
  submittedAt                DateTime?               @map("submitted_at") @db.Timestamptz(6)
  submittedByMemberId        String?                 @map("submitted_by_member_id") @db.Uuid
  awardDate                  DateTime?               @map("award_date") @db.Date
  awardValue                 Decimal?                @map("award_value") @db.Decimal(19, 4)
  awardCurrency              String?                 @map("award_currency") @db.Char(3)
  awardReference             String?                 @map("award_reference")
  awardNotes                 String?                 @map("award_notes")
  lossReason                 TenderLossReason?       @map("loss_reason")
  winningCompany             String?                 @map("winning_company")
  winningValue               Decimal?                @map("winning_value") @db.Decimal(19, 4)
  ourSubmittedValue          Decimal?                @map("our_submitted_value") @db.Decimal(19, 4)
  debriefNotes               String?                 @map("debrief_notes")
  lessonsLearned             String?                 @map("lessons_learned")
  cancelReason               String?                 @map("cancel_reason")
  requirementsTotal          Int                     @default(0) @map("requirements_total")
  mandatoryApplicable        Int                     @default(0) @map("mandatory_applicable")
  mandatoryApproved          Int                     @default(0) @map("mandatory_approved")
  optionalApplicable         Int                     @default(0) @map("optional_applicable")
  optionalApproved           Int                     @default(0) @map("optional_approved")
  blockedRequirements        Int                     @default(0) @map("blocked_requirements")
  unassignedRequirements     Int                     @default(0) @map("unassigned_requirements")
  reviewRound                Int                     @default(0) @map("review_round")
  addendumSeq                Int                     @default(0) @map("addendum_seq")
  archivedAt                 DateTime?               @map("archived_at") @db.Timestamptz(6)
  version                    Int                     @default(1)
  createdByMemberId          String                  @map("created_by_member_id") @db.Uuid
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer       Customer?                 @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  relatedProject Project?                  @relation(fields: [organizationId, relatedProjectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  owner          OrganizationMember        @relation("TenderOwner", fields: [organizationId, ownerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  technicalLead  OrganizationMember?       @relation("TenderTechnicalLead", fields: [organizationId, technicalLeadMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  commercialLead OrganizationMember?       @relation("TenderCommercialLead", fields: [organizationId, commercialLeadMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  submittedBy    OrganizationMember?       @relation("TenderSubmittedBy", fields: [organizationId, submittedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      OrganizationMember        @relation("TenderCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  bidDecisions   TenderBidDecisionRecord[]
  requirements   TenderRequirement[]
  reviewGates    TenderReviewGate[]
  reviews        TenderReview[]
  events         TenderEvent[]
  addenda        TenderAddendum[]
  clarifications TenderClarification[]
  submissions    TenderSubmission[]
  documents      CommercialDocument[]
  guarantees     Guarantee[]
  contracts      Contract[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, submissionDeadlineAt])
  @@index([organizationId, ownerMemberId])
  @@index([organizationId, technicalLeadMemberId])
  @@index([organizationId, commercialLeadMemberId])
  @@index([organizationId, submittedByMemberId])
  @@index([organizationId, createdByMemberId])
  @@index([organizationId, customerId])
  @@index([organizationId, relatedProjectId])
  @@index([organizationId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "tenders_title_trgm_idx")
  @@map("tenders")
}

/// Immutable bid/no-bid decision history (append-only); the tender holds the latest decision.
model TenderBidDecisionRecord {
  id                              String            @id @default(uuid(7)) @db.Uuid
  organizationId                  String            @map("organization_id") @db.Uuid
  tenderId                        String            @map("tender_id") @db.Uuid
  decision                        TenderBidDecision
  technicalFit                    BidCriterionValue @map("technical_fit")
  commercialAttractiveness        BidCriterionValue @map("commercial_attractiveness")
  resourcesAvailable              BidCriterionValue @map("resources_available")
  requiredQualificationsAvailable BidCriterionValue @map("required_qualifications_available")
  deadlineFeasible                BidCriterionValue @map("deadline_feasible")
  strategicCustomer               BidCriterionValue @map("strategic_customer")
  previousExperienceAvailable     BidCriterionValue @map("previous_experience_available")
  /// YES = a significant risk was identified.
  commercialRisk                  BidCriterionValue @map("commercial_risk")
  technicalRisk                   BidCriterionValue @map("technical_risk")
  noBidReason                     NoBidReason?      @map("no_bid_reason")
  comments                        String?
  decidedByMemberId               String            @map("decided_by_member_id") @db.Uuid
  tenderVersion                   Int               @map("tender_version")
  decidedAt                       DateTime          @default(now()) @map("decided_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender       Tender             @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy    OrganizationMember @relation("TenderBidDecidedBy", fields: [organizationId, decidedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, tenderId, decidedAt(sort: Desc)])
  @@index([organizationId, decidedByMemberId])
  @@map("tender_bid_decisions")
}

/// Compliance-matrix row. Direct evidence files are attachments with owner type TENDER_REQUIREMENT.
model TenderRequirement {
  id                 String                    @id @default(uuid(7)) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  tenderId           String                    @map("tender_id") @db.Uuid
  category           TenderRequirementCategory
  title              String
  description        String?
  referenceSection   String?                   @map("reference_section")
  ownerMemberId      String?                   @map("owner_member_id") @db.Uuid
  reviewerMemberId   String?                   @map("reviewer_member_id") @db.Uuid
  dueDate            DateTime?                 @map("due_date") @db.Date
  priority           CommercialPriority        @default(MEDIUM)
  mandatory          Boolean                   @default(true)
  status             TenderRequirementStatus   @default(NOT_STARTED)
  notes              String?
  reviewedByMemberId String?                   @map("reviewed_by_member_id") @db.Uuid
  reviewedAt         DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  version            Int                       @default(1)
  createdByMemberId  String                    @map("created_by_member_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender       Tender                  @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  owner        OrganizationMember?     @relation("TenderRequirementOwner", fields: [organizationId, ownerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewer     OrganizationMember?     @relation("TenderRequirementReviewer", fields: [organizationId, reviewerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy   OrganizationMember?     @relation("TenderRequirementReviewedBy", fields: [organizationId, reviewedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember      @relation("TenderRequirementCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  links        TenderRequirementLink[]

  @@unique([organizationId, id])
  @@index([organizationId, tenderId, status])
  @@index([organizationId, ownerMemberId, dueDate])
  @@index([organizationId, reviewerMemberId, status])
  @@index([organizationId, reviewedByMemberId])
  @@index([organizationId, createdByMemberId])
  @@map("tender_requirements")
}

/// A requirement satisfied by a specific document version (never the mutable "current" pointer).
/// Exactly one target (CHECK). Unlinking sets `removed_at`; the row stays as history.
model TenderRequirementLink {
  id                          String    @id @default(uuid(7)) @db.Uuid
  organizationId              String    @map("organization_id") @db.Uuid
  requirementId               String    @map("requirement_id") @db.Uuid
  corporateDocumentVersionId  String?   @map("corporate_document_version_id") @db.Uuid
  commercialDocumentVersionId String?   @map("commercial_document_version_id") @db.Uuid
  note                        String?
  createdByMemberId           String    @map("created_by_member_id") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt                   DateTime? @map("removed_at") @db.Timestamptz(6)
  removedByMemberId           String?   @map("removed_by_member_id") @db.Uuid

  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requirement               TenderRequirement          @relation(fields: [organizationId, requirementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  corporateDocumentVersion  CorporateDocumentVersion?  @relation(fields: [organizationId, corporateDocumentVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  commercialDocumentVersion CommercialDocumentVersion? @relation("RequirementLinkCommercialVersion", fields: [organizationId, commercialDocumentVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy                 OrganizationMember         @relation("RequirementLinkCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  removedBy                 OrganizationMember?        @relation("RequirementLinkRemovedBy", fields: [organizationId, removedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, requirementId])
  @@index([organizationId, corporateDocumentVersionId])
  @@index([organizationId, commercialDocumentVersionId])
  @@index([organizationId, createdByMemberId])
  @@index([organizationId, removedByMemberId])
  @@map("tender_requirement_links")
}

/// One review gate of one review round. Non-final gates open together; FINAL opens after them.
model TenderReviewGate {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  tenderId       String                 @map("tender_id") @db.Uuid
  round          Int
  gate           TenderReviewGateType
  mode           TenderReviewMode
  status         TenderReviewGateStatus
  openedAt       DateTime?              @map("opened_at") @db.Timestamptz(6)
  closedAt       DateTime?              @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender       Tender         @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reviews      TenderReview[]

  @@unique([organizationId, id])
  @@unique([organizationId, tenderId, round, gate])
  @@map("tender_review_gates")
}

/// One reviewer's decision on a gate. A repeated identical decision is idempotent; others are 409.
model TenderReview {
  id               String             @id @default(uuid(7)) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  tenderId         String             @map("tender_id") @db.Uuid
  gateId           String             @map("gate_id") @db.Uuid
  reviewerMemberId String             @map("reviewer_member_id") @db.Uuid
  status           TenderReviewStatus @default(PENDING)
  comment          String?
  tenderVersion    Int?               @map("tender_version")
  decidedAt        DateTime?          @map("decided_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender       Tender             @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  gate         TenderReviewGate   @relation(fields: [organizationId, gateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewer     OrganizationMember @relation("TenderReviewer", fields: [organizationId, reviewerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, gateId, reviewerMemberId])
  @@index([organizationId, tenderId])
  @@index([organizationId, reviewerMemberId, status])
  @@map("tender_reviews")
}

/// Append-only tender business timeline (trigger + grants); distinct from the security audit log.
model TenderEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tenderId       String   @map("tender_id") @db.Uuid
  type           String
  actorMemberId  String?  @map("actor_member_id") @db.Uuid
  /// i18n parameters and identifiers only; never document contents or money for unauthorized readers.
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender       Tender              @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actor        OrganizationMember? @relation("TenderEventActor", fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, tenderId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, actorMemberId])
  @@map("tender_events")
}

/// Append-only addendum record; a deadline change keeps the previous deadline here.
model TenderAddendum {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  tenderId           String    @map("tender_id") @db.Uuid
  number             Int
  reference          String?
  summary            String
  receivedAt         DateTime  @map("received_at") @db.Timestamptz(6)
  documentVersionId  String?   @map("document_version_id") @db.Uuid
  previousDeadlineAt DateTime? @map("previous_deadline_at") @db.Timestamptz(6)
  previousTimeZone   String?   @map("previous_time_zone")
  newDeadlineAt      DateTime? @map("new_deadline_at") @db.Timestamptz(6)
  newTimeZone        String?   @map("new_time_zone")
  createdByMemberId  String    @map("created_by_member_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender          Tender                     @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  documentVersion CommercialDocumentVersion? @relation("AddendumDocumentVersion", fields: [organizationId, documentVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       OrganizationMember         @relation("TenderAddendumCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, tenderId, number])
  @@index([organizationId, documentVersionId])
  @@index([organizationId, createdByMemberId])
  @@map("tender_addenda")
}

model TenderClarification {
  id                String                    @id @default(uuid(7)) @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  tenderId          String                    @map("tender_id") @db.Uuid
  question          String
  reference         String?
  status            TenderClarificationStatus @default(OPEN)
  submittedAt       DateTime?                 @map("submitted_at") @db.Timestamptz(6)
  response          String?
  respondedAt       DateTime?                 @map("responded_at") @db.Timestamptz(6)
  version           Int                       @default(1)
  createdByMemberId String                    @map("created_by_member_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender       Tender             @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember @relation("TenderClarificationCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, tenderId, createdAt])
  @@index([organizationId, createdByMemberId])
  @@map("tender_clarifications")
}

/// Append-only submission snapshot. A correction is a new row referencing the corrected one.
model TenderSubmission {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  tenderId             String                 @map("tender_id") @db.Uuid
  kind                 TenderSubmissionKind
  idempotencyKey       String                 @map("idempotency_key") @db.Uuid
  method               TenderSubmissionMethod
  reference            String?
  notes                String?
  submittedAt          DateTime               @map("submitted_at") @db.Timestamptz(6)
  submittedByMemberId  String                 @map("submitted_by_member_id") @db.Uuid
  evidenceVersionId    String?                @map("evidence_version_id") @db.Uuid
  correctsSubmissionId String?                @map("corrects_submission_id") @db.Uuid
  tenderVersion        Int                    @map("tender_version")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender          Tender                     @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  submittedBy     OrganizationMember         @relation("TenderSubmissionBy", fields: [organizationId, submittedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  evidenceVersion CommercialDocumentVersion? @relation("SubmissionEvidenceVersion", fields: [organizationId, evidenceVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  corrects        TenderSubmission?          @relation("SubmissionCorrection", fields: [organizationId, correctsSubmissionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  corrections     TenderSubmission[]         @relation("SubmissionCorrection")

  @@unique([organizationId, id])
  @@unique([organizationId, tenderId, idempotencyKey])
  @@index([organizationId, tenderId, createdAt])
  @@index([organizationId, submittedByMemberId])
  @@index([organizationId, evidenceVersionId])
  @@index([organizationId, correctsSubmissionId])
  @@map("tender_submissions")
}

/// Logical tender or contract document (exactly one parent, CHECK). Binaries live in attachments;
/// the current version is the highest `version_number` (versions are append-only).
model CommercialDocument {
  id                String                     @id @default(uuid(7)) @db.Uuid
  organizationId    String                     @map("organization_id") @db.Uuid
  tenderId          String?                    @map("tender_id") @db.Uuid
  contractId        String?                    @map("contract_id") @db.Uuid
  category          CommercialDocumentCategory
  classification    DocumentClassification
  title             String
  description       String?
  currentVersion    Int                        @default(0) @map("current_version")
  archivedAt        DateTime?                  @map("archived_at") @db.Timestamptz(6)
  version           Int                        @default(1)
  createdByMemberId String                     @map("created_by_member_id") @db.Uuid
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender       Tender?                     @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  contract     Contract?                   @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember          @relation("CommercialDocumentCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  versions     CommercialDocumentVersion[]

  @@unique([organizationId, id])
  @@index([organizationId, tenderId, category])
  @@index([organizationId, contractId, category])
  @@index([organizationId, createdByMemberId])
  @@map("commercial_documents")
}

/// Append-only version of a commercial document (trigger + grants).
model CommercialDocumentVersion {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  documentId         String   @map("document_id") @db.Uuid
  versionNumber      Int      @map("version_number")
  attachmentId       String   @map("attachment_id") @db.Uuid
  notes              String?
  uploadedByMemberId String   @map("uploaded_by_member_id") @db.Uuid
  uploadedAt         DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  organization     Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document         CommercialDocument             @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  attachment       Attachment                     @relation("CommercialVersionAttachment", fields: [organizationId, attachmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy       OrganizationMember             @relation("CommercialVersionUploadedBy", fields: [organizationId, uploadedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requirementLinks TenderRequirementLink[]        @relation("RequirementLinkCommercialVersion")
  addenda          TenderAddendum[]               @relation("AddendumDocumentVersion")
  submissions      TenderSubmission[]             @relation("SubmissionEvidenceVersion")
  amendments       ContractAmendment[]            @relation("AmendmentDocumentVersion")
  renewalActions   ContractRenewalAction[]        @relation("RenewalActionDocumentVersion")
  occurrences      ContractObligationOccurrence[] @relation("OccurrenceEvidenceVersion")

  @@unique([organizationId, id])
  @@unique([organizationId, documentId, versionNumber])
  @@unique([organizationId, attachmentId])
  @@index([organizationId, uploadedByMemberId])
  @@map("commercial_document_versions")
}

/// Corporate Document Vault entry. Validity lives on versions; `current_*` mirror the latest version
/// for expiry queries and are written in the same transaction as the version.
model CorporateDocument {
  id                String                  @id @default(uuid(7)) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  documentType      CorporateDocumentType   @map("document_type")
  title             String
  documentNumber    String?                 @map("document_number")
  ownerMemberId     String?                 @map("owner_member_id") @db.Uuid
  classification    DocumentClassification
  status            CorporateDocumentStatus @default(ACTIVE)
  notes             String?
  currentVersion    Int                     @default(0) @map("current_version")
  currentExpiryDate DateTime?               @map("current_expiry_date") @db.Date
  archivedAt        DateTime?               @map("archived_at") @db.Timestamptz(6)
  version           Int                     @default(1)
  createdByMemberId String                  @map("created_by_member_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner        OrganizationMember?        @relation("CorporateDocumentOwner", fields: [organizationId, ownerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember         @relation("CorporateDocumentCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  versions     CorporateDocumentVersion[]

  @@unique([organizationId, id])
  @@index([organizationId, status, currentExpiryDate])
  @@index([organizationId, documentType])
  @@index([organizationId, ownerMemberId])
  @@index([organizationId, createdByMemberId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "corporate_documents_title_trgm_idx")
  @@map("corporate_documents")
}

/// Append-only corporate document version with its own validity (a renewed certificate never
/// rewrites the history of the old one).
model CorporateDocumentVersion {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  documentId         String    @map("document_id") @db.Uuid
  versionNumber      Int       @map("version_number")
  attachmentId       String    @map("attachment_id") @db.Uuid
  issueDate          DateTime? @map("issue_date") @db.Date
  validFrom          DateTime? @map("valid_from") @db.Date
  expiryDate         DateTime? @map("expiry_date") @db.Date
  notes              String?
  uploadedByMemberId String    @map("uploaded_by_member_id") @db.Uuid
  uploadedAt         DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document         CorporateDocument       @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  attachment       Attachment              @relation("CorporateVersionAttachment", fields: [organizationId, attachmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy       OrganizationMember      @relation("CorporateVersionUploadedBy", fields: [organizationId, uploadedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requirementLinks TenderRequirementLink[]

  @@unique([organizationId, id])
  @@unique([organizationId, documentId, versionNumber])
  @@unique([organizationId, attachmentId])
  @@index([organizationId, uploadedByMemberId])
  @@map("corporate_document_versions")
}

/// Contract aggregate (ADR-0026). Original value and expiry are the immutable baseline; current
/// value and expiry are a projection rebuilt from effective amendments and applied renewal actions
/// (`engine/projection.ts`) under the contract's version lock. Health is the canonical evaluation.
model Contract {
  id                    String              @id @default(uuid(7)) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  number                Int
  year                  Int                 @db.SmallInt
  internalReference     String?             @map("internal_reference")
  title                 String
  description           String?
  customerId            String?             @map("customer_id") @db.Uuid
  counterpartyName      String?             @map("counterparty_name")
  sourceTenderId        String?             @map("source_tender_id") @db.Uuid
  projectId             String?             @map("project_id") @db.Uuid
  contractType          ContractType        @map("contract_type")
  currency              String              @db.Char(3)
  originalValue         Decimal             @map("original_value") @db.Decimal(19, 4)
  currentValue          Decimal             @map("current_value") @db.Decimal(19, 4)
  signedDate            DateTime?           @map("signed_date") @db.Date
  effectiveDate         DateTime?           @map("effective_date") @db.Date
  startDate             DateTime?           @map("start_date") @db.Date
  originalExpiryDate    DateTime?           @map("original_expiry_date") @db.Date
  currentExpiryDate     DateTime?           @map("current_expiry_date") @db.Date
  initialTermMonths     Int?                @map("initial_term_months")
  renewalType           ContractRenewalType @default(NONE) @map("renewal_type")
  noticePeriodDays      Int?                @map("notice_period_days")
  renewalDecisionDate   DateTime?           @map("renewal_decision_date") @db.Date
  /// current_expiry_date - notice_period_days, maintained with the projection.
  renewalNoticeDeadline DateTime?           @map("renewal_notice_deadline") @db.Date
  /// Decision (RENEW / DO_NOT_RENEW) for the current term; cleared when a RENEWED/EXTENDED action starts a new term.
  renewalDecision       RenewalActionType?  @map("renewal_decision")
  renewalDecidedAt      DateTime?           @map("renewal_decided_at") @db.Timestamptz(6)
  ownerMemberId         String              @map("owner_member_id") @db.Uuid
  status                ContractStatus      @default(DRAFT)
  statusReason          String?             @map("status_reason")
  warrantyStartDate     DateTime?           @map("warranty_start_date") @db.Date
  warrantyEndDate       DateTime?           @map("warranty_end_date") @db.Date
  supportStartDate      DateTime?           @map("support_start_date") @db.Date
  supportEndDate        DateTime?           @map("support_end_date") @db.Date
  health                CommercialHealth    @default(HEALTHY)
  healthReasons         String[]            @default([]) @map("health_reasons")
  healthEvaluatedOn     DateTime?           @map("health_evaluated_on") @db.Date
  idempotencyKey        String?             @map("idempotency_key") @db.Uuid
  amendmentSeq          Int                 @default(0) @map("amendment_seq")
  version               Int                 @default(1)
  createdByMemberId     String              @map("created_by_member_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer       Customer?                      @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceTender   Tender?                        @relation(fields: [organizationId, sourceTenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  project        Project?                       @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  owner          OrganizationMember             @relation("ContractOwner", fields: [organizationId, ownerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      OrganizationMember             @relation("ContractCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  documents      CommercialDocument[]
  amendments     ContractAmendment[]
  obligations    ContractObligation[]
  occurrences    ContractObligationOccurrence[]
  milestones     ContractMilestone[]
  guarantees     Guarantee[]
  events         ContractEvent[]
  renewalActions ContractRenewalAction[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, health])
  @@index([organizationId, currentExpiryDate])
  @@index([organizationId, renewalNoticeDeadline])
  @@index([organizationId, ownerMemberId])
  @@index([organizationId, createdByMemberId])
  @@index([organizationId, customerId])
  @@index([organizationId, sourceTenderId])
  @@index([organizationId, projectId])
  @@index([organizationId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "contracts_title_trgm_idx")
  @@map("contracts")
}

model ContractAmendment {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  contractId          String                  @map("contract_id") @db.Uuid
  number              Int
  type                ContractAmendmentType
  title               String
  description         String?
  effectiveDate       DateTime                @map("effective_date") @db.Date
  /// Signed delta in the contract currency (`currency` must equal the contract's).
  valueDelta          Decimal?                @map("value_delta") @db.Decimal(19, 4)
  currency            String?                 @db.Char(3)
  newExpiryDate       DateTime?               @map("new_expiry_date") @db.Date
  scopeChangeSummary  String?                 @map("scope_change_summary")
  status              ContractAmendmentStatus @default(DRAFT)
  submittedAt         DateTime?               @map("submitted_at") @db.Timestamptz(6)
  approvedAt          DateTime?               @map("approved_at") @db.Timestamptz(6)
  approvedByMemberId  String?                 @map("approved_by_member_id") @db.Uuid
  rejectionReason     String?                 @map("rejection_reason")
  activatedAt         DateTime?               @map("activated_at") @db.Timestamptz(6)
  activatedByMemberId String?                 @map("activated_by_member_id") @db.Uuid
  documentVersionId   String?                 @map("document_version_id") @db.Uuid
  version             Int                     @default(1)
  createdByMemberId   String                  @map("created_by_member_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract        Contract                   @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy      OrganizationMember?        @relation("AmendmentApprovedBy", fields: [organizationId, approvedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  activatedBy     OrganizationMember?        @relation("AmendmentActivatedBy", fields: [organizationId, activatedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       OrganizationMember         @relation("AmendmentCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  documentVersion CommercialDocumentVersion? @relation("AmendmentDocumentVersion", fields: [organizationId, documentVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, contractId, number])
  @@index([organizationId, contractId, status])
  @@index([organizationId, approvedByMemberId])
  @@index([organizationId, activatedByMemberId])
  @@index([organizationId, createdByMemberId])
  @@index([organizationId, documentVersionId])
  @@map("contract_amendments")
}

/// Obligation definition; the work items are its occurrences (one for NONE, a bounded generated
/// series for MONTHLY/QUARTERLY/YEARLY up to `generated_through`).
model ContractObligation {
  id                String                @id @default(uuid(7)) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  contractId        String                @map("contract_id") @db.Uuid
  title             String
  description       String?
  category          ObligationCategory
  ownerMemberId     String?               @map("owner_member_id") @db.Uuid
  reviewerMemberId  String?               @map("reviewer_member_id") @db.Uuid
  priority          CommercialPriority    @default(MEDIUM)
  criticality       ObligationCriticality @default(STANDARD)
  evidenceRequired  Boolean               @default(false) @map("evidence_required")
  recurrence        ObligationRecurrence  @default(NONE)
  /// First (or only) due date; recurring series keep its day of month (clamped to month end).
  dueDate           DateTime              @map("due_date") @db.Date
  recurrenceUntil   DateTime?             @map("recurrence_until") @db.Date
  generatedThrough  DateTime?             @map("generated_through") @db.Date
  notes             String?
  cancelledAt       DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  version           Int                   @default(1)
  createdByMemberId String                @map("created_by_member_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract     Contract                       @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  owner        OrganizationMember?            @relation("ObligationOwner", fields: [organizationId, ownerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewer     OrganizationMember?            @relation("ObligationReviewer", fields: [organizationId, reviewerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember             @relation("ObligationCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  occurrences  ContractObligationOccurrence[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, contractId])
  @@index([organizationId, contractId])
  @@index([organizationId, recurrence, generatedThrough])
  @@index([organizationId, ownerMemberId])
  @@index([organizationId, reviewerMemberId])
  @@index([organizationId, createdByMemberId])
  @@map("contract_obligations")
}

/// One due instance of an obligation, unique per (obligation, due date) so regeneration is idempotent.
/// Completion evidence: attachments with owner type OBLIGATION_OCCURRENCE or a document version.
model ContractObligationOccurrence {
  id                  String           @id @default(uuid(7)) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  obligationId        String           @map("obligation_id") @db.Uuid
  contractId          String           @map("contract_id") @db.Uuid
  dueDate             DateTime         @map("due_date") @db.Date
  status              ObligationStatus @default(UPCOMING)
  ownerMemberId       String?          @map("owner_member_id") @db.Uuid
  completedAt         DateTime?        @map("completed_at") @db.Timestamptz(6)
  completedByMemberId String?          @map("completed_by_member_id") @db.Uuid
  completionNote      String?          @map("completion_note")
  evidenceVersionId   String?          @map("evidence_version_id") @db.Uuid
  waivedReason        String?          @map("waived_reason")
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  obligation      ContractObligation         @relation(fields: [organizationId, obligationId, contractId], references: [organizationId, id, contractId], onDelete: Restrict, onUpdate: Restrict)
  contract        Contract                   @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  owner           OrganizationMember?        @relation("OccurrenceOwner", fields: [organizationId, ownerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  completedBy     OrganizationMember?        @relation("OccurrenceCompletedBy", fields: [organizationId, completedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  evidenceVersion CommercialDocumentVersion? @relation("OccurrenceEvidenceVersion", fields: [organizationId, evidenceVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, obligationId, dueDate])
  @@index([organizationId, contractId, dueDate])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, ownerMemberId, dueDate])
  @@index([organizationId, obligationId, contractId])
  @@index([organizationId, completedByMemberId])
  @@index([organizationId, evidenceVersionId])
  @@map("contract_obligation_occurrences")
}

/// Contract milestone (separate from obligations). Evidence: attachments with owner type CONTRACT_MILESTONE.
model ContractMilestone {
  id                  String          @id @default(uuid(7)) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  contractId          String          @map("contract_id") @db.Uuid
  projectId           String?         @map("project_id") @db.Uuid
  title               String
  description         String?
  ownerMemberId       String?         @map("owner_member_id") @db.Uuid
  dueDate             DateTime        @map("due_date") @db.Date
  status              MilestoneStatus @default(NOT_STARTED)
  approvalRequired    Boolean         @default(false) @map("approval_required")
  submittedAt         DateTime?       @map("submitted_at") @db.Timestamptz(6)
  approvedAt          DateTime?       @map("approved_at") @db.Timestamptz(6)
  approvedByMemberId  String?         @map("approved_by_member_id") @db.Uuid
  completedAt         DateTime?       @map("completed_at") @db.Timestamptz(6)
  completedByMemberId String?         @map("completed_by_member_id") @db.Uuid
  version             Int             @default(1)
  createdByMemberId   String          @map("created_by_member_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract     Contract            @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  project      Project?            @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  owner        OrganizationMember? @relation("MilestoneOwner", fields: [organizationId, ownerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy   OrganizationMember? @relation("MilestoneApprovedBy", fields: [organizationId, approvedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  completedBy  OrganizationMember? @relation("MilestoneCompletedBy", fields: [organizationId, completedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember  @relation("MilestoneCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, contractId, dueDate])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, projectId])
  @@index([organizationId, ownerMemberId])
  @@index([organizationId, approvedByMemberId])
  @@index([organizationId, completedByMemberId])
  @@index([organizationId, createdByMemberId])
  @@map("contract_milestones")
}

/// Bid security, performance guarantee, ... of exactly one tender or contract (CHECK). Amount and
/// documents follow the parent's financial permission. Documents: attachments with owner type GUARANTEE.
model Guarantee {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  tenderId          String?         @map("tender_id") @db.Uuid
  contractId        String?         @map("contract_id") @db.Uuid
  type              GuaranteeType
  referenceNumber   String          @map("reference_number")
  issuer            String
  beneficiary       String?
  amount            Decimal?        @db.Decimal(19, 4)
  currency          String?         @db.Char(3)
  issueDate         DateTime        @map("issue_date") @db.Date
  expiryDate        DateTime        @map("expiry_date") @db.Date
  releaseDate       DateTime?       @map("release_date") @db.Date
  ownerMemberId     String?         @map("owner_member_id") @db.Uuid
  status            GuaranteeStatus @default(ACTIVE)
  notes             String?
  version           Int             @default(1)
  createdByMemberId String          @map("created_by_member_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tender       Tender?             @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  contract     Contract?           @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  owner        OrganizationMember? @relation("GuaranteeOwner", fields: [organizationId, ownerMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember  @relation("GuaranteeCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, status, expiryDate])
  @@index([organizationId, tenderId])
  @@index([organizationId, contractId])
  @@index([organizationId, ownerMemberId])
  @@index([organizationId, createdByMemberId])
  @@index([organizationId, referenceNumber])
  @@map("guarantees")
}

/// Append-only contract business timeline (trigger + grants).
model ContractEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  contractId     String   @map("contract_id") @db.Uuid
  type           String
  actorMemberId  String?  @map("actor_member_id") @db.Uuid
  /// Identifiers and i18n parameters; money only under the `financial` key (stripped for readers without contract.financial.view).
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract     Contract            @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actor        OrganizationMember? @relation("ContractEventActor", fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, contractId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, actorMemberId])
  @@map("contract_events")
}

/// Append-only renewal decision/action. Only RENEWED and EXTENDED with `new_expiry_date` move the
/// current expiry (through the projection); decisions alone never change a legal date.
model ContractRenewalAction {
  id                String            @id @default(uuid(7)) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  contractId        String            @map("contract_id") @db.Uuid
  action            RenewalActionType
  comment           String?
  newExpiryDate     DateTime?         @map("new_expiry_date") @db.Date
  documentVersionId String?           @map("document_version_id") @db.Uuid
  idempotencyKey    String            @map("idempotency_key") @db.Uuid
  contractVersion   Int               @map("contract_version")
  actorMemberId     String            @map("actor_member_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract        Contract                   @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  documentVersion CommercialDocumentVersion? @relation("RenewalActionDocumentVersion", fields: [organizationId, documentVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actor           OrganizationMember         @relation("RenewalActionActor", fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, contractId, idempotencyKey])
  @@index([organizationId, contractId, createdAt])
  @@index([organizationId, documentVersionId])
  @@index([organizationId, actorMemberId])
  @@map("contract_renewal_actions")
}

/// Exactly-once marker of a date-driven reminder (entity, kind, threshold, due date): the monitor
/// inserts it with ON CONFLICT DO NOTHING before notifying, so reruns never repeat a reminder.
model CommercialReminder {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  kind           String
  thresholdDays  Int      @map("threshold_days")
  dueOn          DateTime @map("due_on") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, entityType, entityId, kind, thresholdDays, dueOn])
  @@index([createdAt])
  @@map("commercial_reminders")
}

/// Organization reminder thresholds (days before the date); absent row = code defaults.
model CommercialSettings {
  id                     String   @id @default(uuid(7)) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  documentReminderDays   Int[]    @map("document_reminder_days") @db.SmallInt
  contractReminderDays   Int[]    @map("contract_reminder_days") @db.SmallInt
  guaranteeReminderDays  Int[]    @map("guarantee_reminder_days") @db.SmallInt
  obligationReminderDays Int[]    @map("obligation_reminder_days") @db.SmallInt
  tenderReminderDays     Int[]    @map("tender_reminder_days") @db.SmallInt
  version                Int      @default(1)
  updatedByMemberId      String?  @map("updated_by_member_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy    OrganizationMember? @relation("CommercialSettingsUpdatedBy", fields: [organizationId, updatedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId])
  @@index([organizationId, updatedByMemberId])
  @@map("commercial_settings")
}
