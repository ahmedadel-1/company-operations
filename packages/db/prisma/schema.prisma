/// Global identity keyed by (idp_issuer, idp_subject), never by email (ADR-0012).
model User {
  id           String        @id @default(uuid(7)) @db.Uuid
  idpIssuer    String        @map("idp_issuer")
  idpSubject   String        @map("idp_subject")
  email        String?       @db.Citext
  displayName  String        @map("display_name")
  platformRole PlatformRole? @map("platform_role")
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         OrganizationMember[]
  auditLogs           AuditLog[]
  platformAuditLogs   PlatformAuditLog[]
  acceptedInvitations MemberInvitation[]

  @@unique([idpIssuer, idpSubject])
  @@map("users")
}

/// `user_id` is null only while INVITED (CHECK constraint): the invitation is bound to an identity
/// when the invitee redeems the single-use token during login (never by email, ADR-0012).
model OrganizationMember {
  id                String       @id @default(uuid(7)) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  userId            String?      @map("user_id") @db.Uuid
  status            MemberStatus @default(INVITED)
  invitedByMemberId String?      @map("invited_by_member_id") @db.Uuid
  /// Incremented on every role/membership change; sessions recompute effective permissions when it moves.
  authzVersion      Int          @default(1) @map("authz_version")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization               Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                       User?                          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy                  OrganizationMember?            @relation("MemberInvitedBy", fields: [organizationId, invitedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  invitees                   OrganizationMember[]           @relation("MemberInvitedBy")
  roles                      MemberRole[]                   @relation("MemberRoleMember")
  grantedRoles               MemberRole[]                   @relation("MemberRoleGrantedBy")
  auditLogs                  AuditLog[]
  profile                    EmployeeProfile?
  invitations                MemberInvitation[]             @relation("InvitationMember")
  createdInvitations         MemberInvitation[]             @relation("InvitationCreatedBy")
  attachments                Attachment[]
  notifications              Notification[]
  notificationPrefs          NotificationPreference[]
  createdProjects            Project[]                      @relation("ProjectCreatedBy")
  addedProjectMembers        ProjectMember[]                @relation("ProjectMemberAddedBy")
  addedProjectLocations      ProjectLocation[]              @relation("ProjectLocationAddedBy")
  submittedDailyReports      DailyReport[]                  @relation("DailyReportSubmittedBy")
  projectActivity            ProjectActivity[]
  reportedTickets            SupportTicket[]                @relation("TicketReporter")
  assignedTickets            SupportTicket[]                @relation("TicketAssignee")
  ticketEvents               SupportTicketEvent[]
  ticketComments             SupportTicketComment[]
  watchedTickets             SupportTicketWatcher[]         @relation("TicketWatcher")
  addedWatchers              SupportTicketWatcher[]         @relation("TicketWatcherAddedBy")
  jiraConnections            JiraConnection[]               @relation("JiraConnectedBy")
  jiraMappings               JiraProjectMapping[]           @relation("JiraMappingCreatedBy")
  jiraSyncRuns               JiraSyncRun[]                  @relation("JiraSyncRequestedBy")
  ticketJiraLinks            SupportTicketJiraLink[]        @relation("TicketJiraLinkCreatedBy")
  jiraCreateRequests         JiraIssueCreateRequest[]       @relation("JiraCreateRequestedBy")
  retentionPolicies          RetentionPolicy[]              @relation("RetentionConfiguredBy")
  githubInstallations        GithubInstallation[]           @relation("GithubInstalledBy")
  githubMappings             GithubRepositoryMapping[]      @relation("GithubMappingCreatedBy")
  githubSyncRuns             GithubSyncRun[]                @relation("GithubSyncRequestedBy")
  githubPrJiraLinks          GithubPrJiraLink[]             @relation("GithubPrJiraLinkDecidedBy")
  ticketGithubLinks          SupportTicketGithubLink[]      @relation("TicketGithubLinkCreatedBy")
  createdRequestTypes        RequestType[]                  @relation("RequestTypeCreatedBy")
  createdWorkflows           WorkflowVersion[]              @relation("WorkflowVersionCreatedBy")
  publishedWorkflows         WorkflowVersion[]              @relation("WorkflowVersionPublishedBy")
  approverOfSteps            WorkflowStep[]                 @relation("WorkflowStepApprover")
  requests                   RequestInstance[]              @relation("RequestRequester")
  requestApprovals           RequestApproval[]              @relation("RequestApprovalApprover")
  decidedApprovals           RequestApproval[]              @relation("RequestApprovalDecidedBy")
  delegationsGiven           ApprovalDelegation[]           @relation("DelegationDelegator")
  delegationsReceived        ApprovalDelegation[]           @relation("DelegationDelegate")
  delegationsCreated         ApprovalDelegation[]           @relation("DelegationCreatedBy")
  delegationsRevoked         ApprovalDelegation[]           @relation("DelegationRevokedBy")
  requestEvents              RequestEvent[]
  attendancePolicies         AttendancePolicy[]             @relation("AttendancePolicyConfiguredBy")
  shiftAssignments           EmployeeShiftAssignment[]      @relation("ShiftAssignmentCreatedBy")
  attendanceRecords          AttendanceRecord[]             @relation("AttendanceRecordMember")
  reviewedAttendance         AttendanceEvent[]              @relation("AttendanceEventReviewedBy")
  attendanceEvents           AttendanceEvent[]              @relation("AttendanceEventActor")
  attendanceAdjustments      AttendanceAdjustmentRequest[]  @relation("AttendanceAdjustmentRequester")
  ownedTenders               Tender[]                       @relation("TenderOwner")
  technicalLeadTenders       Tender[]                       @relation("TenderTechnicalLead")
  commercialLeadTenders      Tender[]                       @relation("TenderCommercialLead")
  submittedTenders           Tender[]                       @relation("TenderSubmittedBy")
  createdTenders             Tender[]                       @relation("TenderCreatedBy")
  tenderBidDecisions         TenderBidDecisionRecord[]      @relation("TenderBidDecidedBy")
  ownedRequirements          TenderRequirement[]            @relation("TenderRequirementOwner")
  reviewerOfRequirements     TenderRequirement[]            @relation("TenderRequirementReviewer")
  reviewedRequirements       TenderRequirement[]            @relation("TenderRequirementReviewedBy")
  createdRequirements        TenderRequirement[]            @relation("TenderRequirementCreatedBy")
  createdRequirementLinks    TenderRequirementLink[]        @relation("RequirementLinkCreatedBy")
  removedRequirementLinks    TenderRequirementLink[]        @relation("RequirementLinkRemovedBy")
  tenderReviews              TenderReview[]                 @relation("TenderReviewer")
  tenderEvents               TenderEvent[]                  @relation("TenderEventActor")
  tenderAddenda              TenderAddendum[]               @relation("TenderAddendumCreatedBy")
  tenderClarifications       TenderClarification[]          @relation("TenderClarificationCreatedBy")
  tenderSubmissions          TenderSubmission[]             @relation("TenderSubmissionBy")
  createdCommercialDocuments CommercialDocument[]           @relation("CommercialDocumentCreatedBy")
  commercialVersions         CommercialDocumentVersion[]    @relation("CommercialVersionUploadedBy")
  ownedCorporateDocuments    CorporateDocument[]            @relation("CorporateDocumentOwner")
  createdCorporateDocuments  CorporateDocument[]            @relation("CorporateDocumentCreatedBy")
  corporateVersions          CorporateDocumentVersion[]     @relation("CorporateVersionUploadedBy")
  ownedContracts             Contract[]                     @relation("ContractOwner")
  createdContracts           Contract[]                     @relation("ContractCreatedBy")
  approvedAmendments         ContractAmendment[]            @relation("AmendmentApprovedBy")
  activatedAmendments        ContractAmendment[]            @relation("AmendmentActivatedBy")
  createdAmendments          ContractAmendment[]            @relation("AmendmentCreatedBy")
  ownedObligations           ContractObligation[]           @relation("ObligationOwner")
  reviewerOfObligations      ContractObligation[]           @relation("ObligationReviewer")
  createdObligations         ContractObligation[]           @relation("ObligationCreatedBy")
  ownedOccurrences           ContractObligationOccurrence[] @relation("OccurrenceOwner")
  completedOccurrences       ContractObligationOccurrence[] @relation("OccurrenceCompletedBy")
  ownedMilestones            ContractMilestone[]            @relation("MilestoneOwner")
  approvedMilestones         ContractMilestone[]            @relation("MilestoneApprovedBy")
  completedMilestones        ContractMilestone[]            @relation("MilestoneCompletedBy")
  createdMilestones          ContractMilestone[]            @relation("MilestoneCreatedBy")
  ownedGuarantees            Guarantee[]                    @relation("GuaranteeOwner")
  createdGuarantees          Guarantee[]                    @relation("GuaranteeCreatedBy")
  contractEvents             ContractEvent[]                @relation("ContractEventActor")
  renewalActions             ContractRenewalAction[]        @relation("RenewalActionActor")
  commercialSettings         CommercialSettings[]           @relation("CommercialSettingsUpdatedBy")

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Per-organization role. System roles are materialized from code templates (ADR-0012).
model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  templateKey    String?  @map("template_key")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions  RolePermission[]
  memberRoles  MemberRole[]
  requestTypes RequestTypeRole[]
  approverOf   WorkflowStep[]

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@map("roles")
}

/// `permission_key` is validated against the code-defined catalog (packages/shared).
model RolePermission {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  roleId         String          @map("role_id") @db.Uuid
  permissionKey  String          @map("permission_key")
  scope          PermissionScope
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, roleId, permissionKey, scope])
  @@map("role_permissions")
}

model MemberRole {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  memberId          String   @map("member_id") @db.Uuid
  roleId            String   @map("role_id") @db.Uuid
  grantedByMemberId String?  @map("granted_by_member_id") @db.Uuid
  grantedAt         DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member       OrganizationMember  @relation("MemberRoleMember", fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  role         Role                @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  grantedBy    OrganizationMember? @relation("MemberRoleGrantedBy", fields: [organizationId, grantedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, memberId, roleId])
  @@index([organizationId, roleId])
  @@map("member_roles")
}

/// Append-only (UPDATE/DELETE/TRUNCATE blocked by trigger and grants). Platform actions go to platform_audit_logs.
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  actorMemberId  String?        @map("actor_member_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  action         String
  entityType     String         @map("entity_type")
  /// Polymorphic reference: not FK-protectable (DATA_MODEL §2.5).
  entityId       String?        @map("entity_id")
  requestId      String?        @map("request_id")
  metadata       Json           @default("{}")
  ip             String?        @db.Inet
  userAgent      String?        @map("user_agent")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser    User?               @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorMember  OrganizationMember? @relation(fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorMemberId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Platform-level, append-only (ADR-0010). Never readable through tenant endpoints.
model PlatformAuditLog {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  actorUserId          String?                @map("actor_user_id") @db.Uuid
  actorType            PlatformAuditActorType @map("actor_type")
  action               String
  targetOrganizationId String?                @map("target_organization_id") @db.Uuid
  metadata             Json                   @default("{}")
  requestId            String?                @map("request_id")
  ip                   String?                @db.Inet
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  actorUser          User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetOrganization Organization? @relation(fields: [targetOrganizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([targetOrganizationId, createdAt(sort: Desc)])
  @@map("platform_audit_logs")
}

/// Department tree (DATA_MODEL §3). Departments are archived, never deleted.
model Department {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  name               String
  code               String    @db.Citext
  parentDepartmentId String?   @map("parent_department_id") @db.Uuid
  managerProfileId   String?   @map("manager_profile_id") @db.Uuid
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent       Department?       @relation("DepartmentTree", fields: [organizationId, parentDepartmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  children     Department[]      @relation("DepartmentTree")
  manager      EmployeeProfile?  @relation("DepartmentManager", fields: [organizationId, managerProfileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  profiles     EmployeeProfile[] @relation("ProfileDepartment")
  teams        Team[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, parentDepartmentId])
  @@index([organizationId, managerProfileId])
  @@map("departments")
}

model JobTitle {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.Citext
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  profiles     EmployeeProfile[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("job_titles")
}

model Team {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.Citext
  departmentId   String?   @map("department_id") @db.Uuid
  leadProfileId  String?   @map("lead_profile_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department        Department?      @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lead              EmployeeProfile? @relation("TeamLead", fields: [organizationId, leadProfileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  members           TeamMember[]
  supportedProjects Project[]        @relation("ProjectSupportTeam")
  assignedTickets   SupportTicket[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, leadProfileId])
  @@map("teams")
}

model TeamMember {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  team         Team            @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  profile      EmployeeProfile @relation(fields: [organizationId, profileId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, teamId, profileId])
  @@index([organizationId, profileId])
  @@map("team_members")
}

/// 1:1 with an organization member (ADR-0012). Manager cycles are rejected by the people service.
model EmployeeProfile {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  memberId           String           @map("member_id") @db.Uuid
  employeeNumber     String           @map("employee_number") @db.Citext
  fullName           String           @map("full_name")
  workEmail          String?          @map("work_email") @db.Citext
  /// Visible only with `employee.view_contact` in scope.
  phone              String?
  departmentId       String?          @map("department_id") @db.Uuid
  jobTitleId         String?          @map("job_title_id") @db.Uuid
  managerProfileId   String?          @map("manager_profile_id") @db.Uuid
  employmentStatus   EmploymentStatus @default(ACTIVE) @map("employment_status")
  employmentType     EmploymentType   @default(FULL_TIME) @map("employment_type")
  joinDate           DateTime?        @map("join_date") @db.Date
  avatarAttachmentId String?          @map("avatar_attachment_id") @db.Uuid
  timeZone           String?          @map("time_zone")
  locale             String?
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member                OrganizationMember            @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  department            Department?                   @relation("ProfileDepartment", fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  jobTitle              JobTitle?                     @relation(fields: [organizationId, jobTitleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  manager               EmployeeProfile?              @relation("ProfileManager", fields: [organizationId, managerProfileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reports               EmployeeProfile[]             @relation("ProfileManager")
  avatar                Attachment?                   @relation("ProfileAvatar", fields: [organizationId, avatarAttachmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  managedDepartments    Department[]                  @relation("DepartmentManager")
  ledTeams              Team[]                        @relation("TeamLead")
  teamMemberships       TeamMember[]
  managedProjects       Project[]                     @relation("ProjectManager")
  techManagedProjects   Project[]                     @relation("ProjectTechnicalManager")
  projectMemberships    ProjectMember[]
  dailyReports          DailyReport[]
  shiftAssignments      EmployeeShiftAssignment[]
  attendanceRecords     AttendanceRecord[]
  attendanceEvents      AttendanceEvent[]
  attendanceAdjustments AttendanceAdjustmentRequest[]

  @@unique([organizationId, id])
  @@unique([organizationId, memberId])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerProfileId])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, fullName])
  /// Global search (ADR-0023): case-insensitive substring match on names.
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "employee_profiles_full_name_trgm_idx")
  @@map("employee_profiles")
}

/// Single-use invitation. Only the SHA-256 of the token is stored; the token is shown once.
model MemberInvitation {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  memberId          String    @map("member_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  email             String?   @db.Citext
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId  String?   @map("accepted_by_user_id") @db.Uuid
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdByMemberId String?   @map("created_by_member_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member       OrganizationMember  @relation("InvitationMember", fields: [organizationId, memberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember? @relation("InvitationCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy   User?               @relation(fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, memberId])
  @@map("member_invitations")
}

/// Per-organization sequences for human-readable numbers (SUP, REQ, DR, PRJ, EMP).
/// Incremented only by `platform/db/sql/counters.ts` (atomic upsert bound to organization_id).
model OrganizationCounter {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  value          BigInt @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, key])
  @@map("organization_counters")
}

/// Polymorphic owner (`owner_type`, `owner_id`): not FK-protectable; enforced by the attachment
/// service resolving the owner in the active organization (DATA_MODEL §2.5).
model Attachment {
  id                  String               @id @default(uuid(7)) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  ownerType           AttachmentOwnerType  @map("owner_type")
  ownerId             String               @map("owner_id") @db.Uuid
  /// `org/<orgId>/<ownerType>/<uuid>`; never derived from the user's file name.
  storageKey          String               @unique @map("storage_key")
  originalFilename    String               @map("original_filename")
  declaredContentType String               @map("declared_content_type")
  declaredSizeBytes   Int                  @map("declared_size_bytes")
  /// Sniffed server-side from the stored bytes.
  contentType         String?              @map("content_type")
  sizeBytes           Int?                 @map("size_bytes")
  checksumSha256      String?              @map("checksum_sha256")
  status              AttachmentStatus     @default(PENDING_UPLOAD)
  scanStatus          AttachmentScanStatus @default(NOT_SCANNED) @map("scan_status")
  rejectionReason     String?              @map("rejection_reason")
  uploadedByMemberId  String               @map("uploaded_by_member_id") @db.Uuid
  uploadExpiresAt     DateTime             @map("upload_expires_at") @db.Timestamptz(6)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy         OrganizationMember          @relation(fields: [organizationId, uploadedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  avatarOfProfile    EmployeeProfile[]           @relation("ProfileAvatar")
  commercialVersions CommercialDocumentVersion[] @relation("CommercialVersionAttachment")
  corporateVersions  CorporateDocumentVersion[]  @relation("CorporateVersionAttachment")

  @@unique([organizationId, id])
  @@index([organizationId, ownerType, ownerId])
  @@index([status, uploadExpiresAt])
  @@map("attachments")
}

/// In-app notification (ADR-0011 foundation). `dedupe_key` makes producers idempotent.
model Notification {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  recipientMemberId String               @map("recipient_member_id") @db.Uuid
  type              String
  entityType        String?              @map("entity_type")
  entityId          String?              @map("entity_id")
  /// i18n parameters only; never secrets.
  params            Json                 @default("{}")
  severity          NotificationSeverity @default(INFO)
  dedupeKey         String               @map("dedupe_key")
  readAt            DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient    OrganizationMember     @relation(fields: [organizationId, recipientMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  deliveries   NotificationDelivery[]

  @@unique([organizationId, id])
  @@unique([organizationId, recipientMemberId, dedupeKey])
  @@index([organizationId, recipientMemberId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Transactional outbox (ARCHITECTURE §3): written in the same transaction as the business change,
/// relayed to BullMQ by the worker. Payloads carry identifiers only.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String?   @map("aggregate_id")
  eventType      String    @map("event_type")
  payload        Json      @default("{}")
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([dispatchedAt, availableAt])
  @@map("outbox_events")
}

/// Lightweight customer record (DATA_MODEL §4); archived, never deleted. Not a CRM.
model Customer {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.Citext
  type           CustomerType
  contactName    String?      @map("contact_name")
  contactEmail   String?      @map("contact_email") @db.Citext
  notes          String?
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  projects     Project[]
  tenders      Tender[]
  contracts    Contract[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("customers")
}

/// Project aggregate (DATA_MODEL §4). `version` is the optimistic-concurrency token; `number` comes
/// from the organization's `PRJ` counter. Status ARCHIVED is reached only through archive.
model Project {
  id                        String        @id @default(uuid(7)) @db.Uuid
  organizationId            String        @map("organization_id") @db.Uuid
  number                    Int
  code                      String        @db.Citext
  name                      String
  description               String?
  customerId                String?       @map("customer_id") @db.Uuid
  status                    ProjectStatus @default(PLANNING)
  statusReason              String?       @map("status_reason")
  statusChangedAt           DateTime?     @map("status_changed_at") @db.Timestamptz(6)
  health                    ProjectHealth @default(HEALTHY)
  /// Reason for the last manual health change (no automatic scoring).
  healthNote                String?       @map("health_note")
  healthChangedAt           DateTime?     @map("health_changed_at") @db.Timestamptz(6)
  startDate                 DateTime?     @map("start_date") @db.Date
  targetEndDate             DateTime?     @map("target_end_date") @db.Date
  projectManagerProfileId   String?       @map("project_manager_profile_id") @db.Uuid
  technicalManagerProfileId String?       @map("technical_manager_profile_id") @db.Uuid
  /// Default team for new support tickets of this project (DATA_MODEL §5).
  supportTeamId             String?       @map("support_team_id") @db.Uuid
  /// IANA zone for business dates of this project; null = the organization's zone.
  timeZone                  String?       @map("time_zone")
  dailyReportPolicy         Json          @default("{\"required\": false, \"weekdays\": [], \"dueLocalTime\": \"18:00\", \"reporterRoles\": [\"FIELD\"]}") @map("daily_report_policy")
  notes                     String?
  archivedAt                DateTime?     @map("archived_at") @db.Timestamptz(6)
  version                   Int           @default(1)
  createdByMemberId         String?       @map("created_by_member_id") @db.Uuid
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer          Customer?                 @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  projectManager    EmployeeProfile?          @relation("ProjectManager", fields: [organizationId, projectManagerProfileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  technicalManager  EmployeeProfile?          @relation("ProjectTechnicalManager", fields: [organizationId, technicalManagerProfileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy         OrganizationMember?       @relation("ProjectCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  supportTeam       Team?                     @relation("ProjectSupportTeam", fields: [organizationId, supportTeamId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  members           ProjectMember[]
  locations         ProjectLocation[]
  dailyReports      DailyReport[]
  activity          ProjectActivity[]
  supportComponents SupportComponent[]
  supportTickets    SupportTicket[]
  jiraMappings      JiraProjectMapping[]
  githubMappings    GithubRepositoryMapping[]
  requests          RequestInstance[]
  tenders           Tender[]
  contracts         Contract[]
  milestones        ContractMilestone[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, health])
  @@index([organizationId, customerId])
  @@index([organizationId, projectManagerProfileId])
  @@index([organizationId, technicalManagerProfileId])
  @@index([organizationId, supportTeamId])
  @@index([organizationId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "projects_name_trgm_idx")
  @@map("projects")
}

/// Staffing of a project (DATA_MODEL §4). Membership is what the PROJECT scope reaches
/// (SECURITY §2.1); `project_role` describes the work and selects daily-report reporters.
model ProjectMember {
  id                String      @id @default(uuid(7)) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  projectId         String      @map("project_id") @db.Uuid
  profileId         String      @map("profile_id") @db.Uuid
  projectRole       ProjectRole @map("project_role")
  allocationPercent Int?        @map("allocation_percent") @db.SmallInt
  startDate         DateTime    @map("start_date") @db.Date
  endDate           DateTime?   @map("end_date") @db.Date
  addedByMemberId   String?     @map("added_by_member_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project      Project             @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  profile      EmployeeProfile     @relation(fields: [organizationId, profileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  addedBy      OrganizationMember? @relation("ProjectMemberAddedBy", fields: [organizationId, addedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, projectId, profileId])
  @@index([organizationId, profileId])
  @@map("project_members")
}

/// Shared with attendance (Phase 7 geofences reuse these rows unchanged).
model WorkLocation {
  id                  String           @id @default(uuid(7)) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  name                String           @db.Citext
  type                WorkLocationType
  latitude            Decimal          @db.Decimal(9, 6)
  longitude           Decimal          @db.Decimal(9, 6)
  allowedRadiusMeters Int              @map("allowed_radius_meters")
  address             String?
  timeZone            String?          @map("time_zone")
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  projectLocations ProjectLocation[]
  checkInRecords   AttendanceRecord[] @relation("AttendanceCheckInLocation")
  checkOutRecords  AttendanceRecord[] @relation("AttendanceCheckOutLocation")
  attendanceEvents AttendanceEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("work_locations")
}

model ProjectLocation {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  workLocationId  String   @map("work_location_id") @db.Uuid
  addedByMemberId String?  @map("added_by_member_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project      Project             @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  workLocation WorkLocation        @relation(fields: [organizationId, workLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  addedBy      OrganizationMember? @relation("ProjectLocationAddedBy", fields: [organizationId, addedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, projectId, workLocationId])
  @@index([organizationId, workLocationId])
  @@map("project_locations")
}

/// One report per project, reporter and business date (`report_date` in the project's zone).
/// Missing reports are computed, never stored (DATA_MODEL §4).
model DailyReport {
  id                     String            @id @default(uuid(7)) @db.Uuid
  organizationId         String            @map("organization_id") @db.Uuid
  number                 Int
  projectId              String            @map("project_id") @db.Uuid
  reporterProfileId      String            @map("reporter_profile_id") @db.Uuid
  reportDate             DateTime          @map("report_date") @db.Date
  systemStatus           DailyReportStatus @map("system_status")
  workPerformed          String            @map("work_performed")
  operationalNotes       String?           @map("operational_notes")
  customerNotes          String?           @map("customer_notes")
  problems               String?
  followUpRequired       Boolean           @default(false) @map("follow_up_required")
  followUpNotes          String?           @map("follow_up_notes")
  processedRequestsCount Int?              @map("processed_requests_count")
  failedRequestsCount    Int?              @map("failed_requests_count")
  submittedByMemberId    String            @map("submitted_by_member_id") @db.Uuid
  submittedAt            DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project      Project            @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reporter     EmployeeProfile    @relation(fields: [organizationId, reporterProfileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  submittedBy  OrganizationMember @relation("DailyReportSubmittedBy", fields: [organizationId, submittedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, projectId, reporterProfileId, reportDate])
  @@index([organizationId, projectId, reportDate(sort: Desc), id(sort: Desc)])
  @@index([organizationId, reporterProfileId, reportDate(sort: Desc)])
  @@index([organizationId, reportDate])
  @@map("daily_reports")
}

/// Operational timeline (read model, not audit). Written only by the outbox consumer, idempotent by
/// `source_event_id`, and rebuildable from the retained outbox events (DATA_MODEL §4).
model ProjectActivity {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  projectId      String                @map("project_id") @db.Uuid
  occurredAt     DateTime              @map("occurred_at") @db.Timestamptz(6)
  source         ProjectActivitySource
  type           String
  entityType     String                @map("entity_type")
  /// Polymorphic reference: not FK-protectable (DATA_MODEL §2.5).
  entityId       String?               @map("entity_id")
  /// i18n parameters only, never rendered text or secrets.
  summaryParams  Json                  @default("{}") @map("summary_params")
  actorMemberId  String?               @map("actor_member_id") @db.Uuid
  sourceEventId  String                @map("source_event_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project      Project             @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actorMember  OrganizationMember? @relation(fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, sourceEventId])
  @@index([organizationId, projectId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("project_activity")
}

/// Support taxonomy (DATA_MODEL §5); deactivated, never deleted (tickets keep their reference).
model SupportCategory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.Citext
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tickets      SupportTicket[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("support_categories")
}

/// System/component of the customer system; `project_id` null = available to every project.
model SupportComponent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.Citext
  projectId      String?  @map("project_id") @db.Uuid
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project      Project?        @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  tickets      SupportTicket[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, projectId])
  @@map("support_components")
}

/// Working hours per ISO weekday plus holidays, used by SLA policies with `business_hours_only`.
/// `time_zone` null = the ticket's project zone, else the organization's zone.
model BusinessCalendar {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.Citext
  timeZone       String?  @map("time_zone")
  /// `[{ "weekday": 1..7, "start": "HH:MM", "end": "HH:MM" }]`, at most one window per weekday.
  workingHours   Json     @map("working_hours")
  /// `["YYYY-MM-DD", ...]` local dates without working hours.
  holidays       Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  slaPolicies  SlaPolicy[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("business_calendars")
}

/// First active policy (ascending `priority`) whose `match` fits the ticket applies (DATA_MODEL §5).
model SlaPolicy {
  id                     String         @id @default(uuid(7)) @db.Uuid
  organizationId         String         @map("organization_id") @db.Uuid
  name                   String         @db.Citext
  priority               Int
  /// `{ severities?, priorities?, projectIds?, categoryIds? }`; an absent or empty list matches anything.
  match                  Json           @default("{}")
  firstResponseMinutes   Int            @map("first_response_minutes")
  resolutionMinutes      Int            @map("resolution_minutes")
  atRiskThresholdPercent Int            @default(75) @map("at_risk_threshold_percent") @db.SmallInt
  businessHoursOnly      Boolean        @default(false) @map("business_hours_only")
  businessCalendarId     String?        @map("business_calendar_id") @db.Uuid
  pauseStatuses          TicketStatus[] @default([WAITING_FOR_CUSTOMER]) @map("pause_statuses")
  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessCalendar BusinessCalendar? @relation(fields: [organizationId, businessCalendarId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  tickets          SupportTicket[]
  escalationRules  EscalationRule[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, active, priority])
  @@map("sla_policies")
}

/// Multi-level escalation (DATA_MODEL §5). `sla_policy_id` null = applies to every policy.
model EscalationRule {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.Citext
  slaPolicyId    String?           @map("sla_policy_id") @db.Uuid
  match          Json              @default("{}")
  level          Int               @db.SmallInt
  trigger        EscalationTrigger
  threshold      Int
  /// `{ roles: [roleKey], projectRoles: [ProjectRole], memberIds: [uuid] }`.
  notify         Json              @default("{}")
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  slaPolicy    SlaPolicy?   @relation(fields: [organizationId, slaPolicyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  slaEvents    SlaEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("escalation_rules")
}

/// Support ticket aggregate (DATA_MODEL §5). Current state lives here; `support_ticket_events`
/// explains how it changed. `version` is the optimistic-concurrency token for user changes; SLA
/// state columns are maintained by the SLA evaluator without bumping it.
model SupportTicket {
  id                    String         @id @default(uuid(7)) @db.Uuid
  organizationId        String         @map("organization_id") @db.Uuid
  number                Int
  projectId             String?        @map("project_id") @db.Uuid
  reporterMemberId      String         @map("reporter_member_id") @db.Uuid
  source                TicketSource
  categoryId            String?        @map("category_id") @db.Uuid
  componentId           String?        @map("component_id") @db.Uuid
  title                 String
  description           String
  severity              TicketSeverity
  priority              TicketPriority
  impact                TicketImpact
  status                TicketStatus   @default(NEW)
  assignedTeamId        String?        @map("assigned_team_id") @db.Uuid
  assigneeMemberId      String?        @map("assignee_member_id") @db.Uuid
  escalationLevel       Int            @default(0) @map("escalation_level") @db.SmallInt
  slaPolicyId           String?        @map("sla_policy_id") @db.Uuid
  /// Clock origin of both SLA targets (creation time).
  slaStartedAt          DateTime       @default(now()) @map("sla_started_at") @db.Timestamptz(6)
  firstResponseDueAt    DateTime?      @map("first_response_due_at") @db.Timestamptz(6)
  resolutionDueAt       DateTime?      @map("resolution_due_at") @db.Timestamptz(6)
  firstRespondedAt      DateTime?      @map("first_responded_at") @db.Timestamptz(6)
  resolvedAt            DateTime?      @map("resolved_at") @db.Timestamptz(6)
  verifiedAt            DateTime?      @map("verified_at") @db.Timestamptz(6)
  closedAt              DateTime?      @map("closed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  /// Public summary of the fix, required to resolve.
  resolutionNote        String?        @map("resolution_note")
  /// Accumulated stopped time, in seconds of the policy's clock (business or wall-clock).
  slaPausedTotalSeconds Int            @default(0) @map("sla_paused_total_seconds")
  slaPausedSince        DateTime?      @map("sla_paused_since") @db.Timestamptz(6)
  firstResponseSlaState SlaState?      @map("first_response_sla_state")
  resolutionSlaState    SlaState?      @map("resolution_sla_state")
  /// Client-generated key of the create request (`Idempotency-Key`), unique per reporter.
  idempotencyKey        String?        @map("idempotency_key") @db.Uuid
  version               Int            @default(1)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project            Project?                  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reporter           OrganizationMember        @relation("TicketReporter", fields: [organizationId, reporterMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  category           SupportCategory?          @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  component          SupportComponent?         @relation(fields: [organizationId, componentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  assignedTeam       Team?                     @relation(fields: [organizationId, assignedTeamId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  assignee           OrganizationMember?       @relation("TicketAssignee", fields: [organizationId, assigneeMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  slaPolicy          SlaPolicy?                @relation(fields: [organizationId, slaPolicyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  events             SupportTicketEvent[]
  comments           SupportTicketComment[]
  watchers           SupportTicketWatcher[]
  slaEvents          SlaEvent[]
  jiraLinks          SupportTicketJiraLink[]
  jiraCreateRequests JiraIssueCreateRequest[]
  githubLinks        SupportTicketGithubLink[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, reporterMemberId, idempotencyKey])
  @@index([organizationId, status, severity])
  @@index([organizationId, projectId, status])
  @@index([organizationId, assigneeMemberId, status])
  @@index([organizationId, assignedTeamId, status])
  @@index([organizationId, reporterMemberId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, categoryId])
  @@index([organizationId, componentId])
  @@index([organizationId, slaPolicyId])
  @@index([organizationId, resolutionDueAt], map: "support_tickets_open_resolution_due_idx", where: raw("status <> ALL (ARRAY['RESOLVED'::\"TicketStatus\", 'VERIFIED'::\"TicketStatus\", 'CLOSED'::\"TicketStatus\", 'CANCELLED'::\"TicketStatus\"])"))
  /// "Resolved today" and the resolved trend (ADR-0023).
  @@index([organizationId, resolvedAt], map: "support_tickets_resolved_at_idx", where: raw("resolved_at IS NOT NULL"))
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "support_tickets_title_trgm_idx")
  @@map("support_tickets")
}

/// Append-only operational history (UPDATE/DELETE/TRUNCATE blocked by trigger and grants).
model SupportTicketEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  /// Null for system changes (SLA worker).
  actorMemberId  String?  @map("actor_member_id") @db.Uuid
  type           String
  fromValue      Json?    @map("from_value")
  toValue        Json?    @map("to_value")
  /// Identifiers and enum values only; never comment bodies.
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket       SupportTicket       @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actorMember  OrganizationMember? @relation(fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, ticketId, createdAt, id])
  @@map("support_ticket_events")
}

/// `PUBLIC_INTERNAL` = visible to everyone who can view the ticket (including the reporter);
/// `INTERNAL_NOTE` = visible only with `support.internal_note` on the ticket.
model SupportTicketComment {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  ticketId       String                  @map("ticket_id") @db.Uuid
  authorMemberId String                  @map("author_member_id") @db.Uuid
  body           String
  visibility     TicketCommentVisibility
  editedAt       DateTime?               @map("edited_at") @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket       SupportTicket      @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  author       OrganizationMember @relation(fields: [organizationId, authorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, ticketId, createdAt, id])
  @@map("support_ticket_comments")
}

model SupportTicketWatcher {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  ticketId        String   @map("ticket_id") @db.Uuid
  memberId        String   @map("member_id") @db.Uuid
  addedByMemberId String?  @map("added_by_member_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket       SupportTicket       @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  member       OrganizationMember  @relation("TicketWatcher", fields: [organizationId, memberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  addedBy      OrganizationMember? @relation("TicketWatcherAddedBy", fields: [organizationId, addedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, ticketId, memberId])
  @@index([organizationId, memberId])
  @@map("support_ticket_watchers")
}

/// Append-only SLA history. The partial unique key makes at-risk, breach and escalation events (and
/// their notifications) happen exactly once per ticket, kind and level; pause/resume may repeat.
model SlaEvent {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  ticketId         String       @map("ticket_id") @db.Uuid
  kind             SlaEventKind
  /// Escalation level for ESCALATED, otherwise 0.
  level            Int          @default(0) @db.SmallInt
  escalationRuleId String?      @map("escalation_rule_id") @db.Uuid
  metadata         Json         @default("{}")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket         SupportTicket   @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  escalationRule EscalationRule? @relation(fields: [organizationId, escalationRuleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, ticketId, kind, level], map: "sla_events_once_key", where: raw("kind <> ALL (ARRAY['PAUSED'::\"SlaEventKind\", 'RESUMED'::\"SlaEventKind\"])"))
  @@index([organizationId, ticketId, createdAt])
  @@index([organizationId, escalationRuleId])
  @@map("sla_events")
}

/// One outbound delivery per notification and channel (dedupe); status is tracked for retries.
model NotificationDelivery {
  id             String                     @id @default(uuid(7)) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  /// Short, redacted error class/message; never message content.
  lastError      String?                    @map("last_error")
  sentAt         DateTime?                  @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notification Notification @relation(fields: [organizationId, notificationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, notificationId, channel])
  @@index([organizationId, status])
  @@map("notification_deliveries")
}

/// A member's opt-out per category and channel (Phase 8, ADR-0023). No row = enabled. Locked
/// categories (security, critical severity) are enforced in code and cannot be stored as disabled.
model NotificationPreference {
  id             String                        @id @default(uuid(7)) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  memberId       String                        @map("member_id") @db.Uuid
  category       NotificationCategory
  channel        NotificationPreferenceChannel
  enabled        Boolean
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member       OrganizationMember @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, memberId, category, channel])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------------------------
// Phase 4 — Jira Cloud (DATA_MODEL §8, ADR-0019). Jira owns development work; these tables are a
// rebuildable, read-oriented cache plus our own connection, mapping, sync and link records.
// ---------------------------------------------------------------------------------------------

enum JiraAuthType {
  OAUTH2_3LO
}

enum JiraConnectionStatus {
  ACTIVE
  /// The refresh token was rejected (`invalid_grant`) or access was revoked; an admin must reconnect.
  NEEDS_REAUTH
  /// Repeated non-authorization failures; syncs keep retrying on schedule.
  ERROR
  DISCONNECTED
}

enum JiraImportState {
  NOT_STARTED
  RUNNING
  COMPLETED
  FAILED
}

enum JiraStatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum JiraSyncRunType {
  INITIAL_IMPORT
  RECONCILIATION
  DEEP_RECONCILIATION
  MANUAL_RESYNC
}

enum JiraSyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum JiraFailureClass {
  RETRYABLE
  PERMANENT
}

enum JiraWebhookDeliveryStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum TicketJiraLinkType {
  CAUSED_BY
  FIX_TRACKED_BY
  RELATED
}

enum TicketJiraLinkSource {
  LINKED_EXISTING
  CREATED_FROM_TICKET
}

enum JiraCreateRequestStatus {
  PENDING
  CREATED
  FAILED
  /// Jira was called but the outcome was never recorded (crash); the issue may exist.
  UNKNOWN
}

/// An organization's Jira Cloud site connection. Tokens are AES-256-GCM envelopes bound to
/// `organizationId|connectionId|field` and never leave the backend.
model JiraConnection {
  id                  String               @id @default(uuid(7)) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  /// Atlassian site id from `accessible-resources` (never from the browser).
  cloudId             String               @map("cloud_id")
  siteUrl             String               @map("site_url")
  siteName            String               @map("site_name")
  authType            JiraAuthType         @default(OAUTH2_3LO) @map("auth_type")
  status              JiraConnectionStatus @default(ACTIVE)
  accessTokenEnc      String?              @map("access_token_enc")
  refreshTokenEnc     String?              @map("refresh_token_enc")
  tokenExpiresAt      DateTime?            @map("token_expires_at") @db.Timestamptz(6)
  /// Key id of the envelopes above; rows under an old key are re-encrypted when next used.
  encryptionKeyId     String?              @map("encryption_key_id")
  scopes              String[]             @default([])
  connectedByMemberId String?              @map("connected_by_member_id") @db.Uuid
  connectedAt         DateTime             @default(now()) @map("connected_at") @db.Timestamptz(6)
  lastSuccessAt       DateTime?            @map("last_success_at") @db.Timestamptz(6)
  lastErrorCode       String?              @map("last_error_code")
  lastErrorAt         DateTime?            @map("last_error_at") @db.Timestamptz(6)
  webhookErrorCode    String?              @map("webhook_error_code")
  disconnectedAt      DateTime?            @map("disconnected_at") @db.Timestamptz(6)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connectedBy   OrganizationMember?       @relation("JiraConnectedBy", fields: [organizationId, connectedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  mappings      JiraProjectMapping[]
  issues        JiraIssue[]
  syncRuns      JiraSyncRun[]
  registrations JiraWebhookRegistration[]
  deliveries    JiraWebhookDelivery[]

  @@unique([organizationId, id])
  @@unique([organizationId, cloudId])
  @@unique([organizationId], map: "jira_connections_live_key", where: raw("status <> 'DISCONNECTED'::\"JiraConnectionStatus\""))
  @@index([status])
  @@map("jira_connections")
}

/// Internal project ↔ Jira project. A Jira project maps to one internal project per connection; an
/// internal project may map to several Jira projects. Removal is soft so links and cache rows stay.
model JiraProjectMapping {
  id                   String          @id @default(uuid(7)) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  connectionId         String          @map("connection_id") @db.Uuid
  projectId            String          @map("project_id") @db.Uuid
  /// Immutable Jira project id; key and name are display copies refreshed on sync.
  jiraProjectId        String          @map("jira_project_id")
  jiraProjectKey       String          @map("jira_project_key")
  jiraProjectName      String          @map("jira_project_name")
  syncEnabled          Boolean         @default(true) @map("sync_enabled")
  importState          JiraImportState @default(NOT_STARTED) @map("import_state")
  /// Status names that mark an issue as blocked; empty = names containing "block".
  blockedStatuses      String[]        @default([]) @map("blocked_statuses")
  lastFullSyncAt       DateTime?       @map("last_full_sync_at") @db.Timestamptz(6)
  lastReconciledAt     DateTime?       @map("last_reconciled_at") @db.Timestamptz(6)
  lastDeepReconciledAt DateTime?       @map("last_deep_reconciled_at") @db.Timestamptz(6)
  createdByMemberId    String?         @map("created_by_member_id") @db.Uuid
  removedAt            DateTime?       @map("removed_at") @db.Timestamptz(6)
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection     JiraConnection           @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  project        Project                  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      OrganizationMember?      @relation("JiraMappingCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  issues         JiraIssue[]
  syncRuns       JiraSyncRun[]
  createRequests JiraIssueCreateRequest[]

  @@unique([organizationId, id])
  @@unique([organizationId, connectionId, jiraProjectId])
  @@index([organizationId, projectId])
  @@map("jira_project_mappings")
}

/// Local, rebuildable copy of the Jira issue fields the product needs. Identity is Jira's immutable
/// issue id per connection; keys change when issues move.
model JiraIssue {
  id                  String             @id @default(uuid(7)) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  connectionId        String             @map("connection_id") @db.Uuid
  /// Null when the issue moved to a Jira project that is not mapped.
  mappingId           String?            @map("mapping_id") @db.Uuid
  jiraIssueId         String             @map("jira_issue_id")
  issueKey            String             @map("issue_key")
  jiraProjectId       String             @map("jira_project_id")
  summary             String
  issueType           String             @map("issue_type")
  statusName          String             @map("status_name")
  statusCategory      JiraStatusCategory @map("status_category")
  priorityName        String?            @map("priority_name")
  assigneeAccountId   String?            @map("assignee_account_id")
  assigneeDisplayName String?            @map("assignee_display_name")
  reporterDisplayName String?            @map("reporter_display_name")
  jiraCreatedAt       DateTime           @map("jira_created_at") @db.Timestamptz(6)
  jiraUpdatedAt       DateTime           @map("jira_updated_at") @db.Timestamptz(6)
  dueDate             DateTime?          @map("due_date") @db.Date
  resolution          String?
  resolvedAt          DateTime?          @map("resolved_at") @db.Timestamptz(6)
  labels              String[]           @default([])
  parentIssueId       String?            @map("parent_issue_id")
  isBlocked           Boolean            @default(false) @map("is_blocked")
  url                 String
  syncHash            String             @map("sync_hash")
  lastSyncedAt        DateTime           @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  /// Tombstone: deleted in Jira, or no longer visible to the connection.
  deletedInJiraAt     DateTime?          @map("deleted_in_jira_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection   JiraConnection          @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  mapping      JiraProjectMapping?     @relation(fields: [organizationId, mappingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  ticketLinks  SupportTicketJiraLink[]
  prLinks      GithubPrJiraLink[]

  @@unique([organizationId, id])
  @@unique([organizationId, connectionId, jiraIssueId])
  @@index([organizationId, mappingId, statusCategory])
  @@index([organizationId, mappingId, jiraUpdatedAt(sort: Desc)])
  @@index([organizationId, connectionId, issueKey])
  @@index([issueKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "jira_issues_issue_key_trgm_idx")
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin, map: "jira_issues_summary_trgm_idx")
  @@map("jira_issues")
}

/// Import and reconciliation runs. At most one QUEUED/RUNNING run per mapping (partial unique key).
model JiraSyncRun {
  id                  String            @id @default(uuid(7)) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  connectionId        String            @map("connection_id") @db.Uuid
  mappingId           String            @map("mapping_id") @db.Uuid
  type                JiraSyncRunType
  status              JiraSyncRunStatus @default(QUEUED)
  cancelRequested     Boolean           @default(false) @map("cancel_requested")
  requestedByMemberId String?           @map("requested_by_member_id") @db.Uuid
  /// Request id of the API call that started the run (correlation).
  requestId           String?           @map("request_id")
  /// BullMQ id of the job currently carrying the run.
  jobId               String?           @map("job_id")
  resumedFromRunId    String?           @map("resumed_from_run_id") @db.Uuid
  startedAt           DateTime?         @map("started_at") @db.Timestamptz(6)
  finishedAt          DateTime?         @map("finished_at") @db.Timestamptz(6)
  /// From `search/approximate-count`; an estimate, never a promise.
  recordsEstimated    Int?              @map("records_estimated")
  recordsProcessed    Int               @default(0) @map("records_processed")
  recordsCreated      Int               @default(0) @map("records_created")
  recordsUpdated      Int               @default(0) @map("records_updated")
  recordsUnchanged    Int               @default(0) @map("records_unchanged")
  recordsFailed       Int               @default(0) @map("records_failed")
  pages               Int               @default(0)
  consecutiveErrors   Int               @default(0) @map("consecutive_errors")
  /// Durable checkpoint `{ createdAfter?, updatedAfter?, pageToken?, lastIssueId? }`.
  lastCursor          Json              @default("{}") @map("last_cursor")
  errorCode           String?           @map("error_code")
  errorSummary        String?           @map("error_summary")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection   JiraConnection      @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  mapping      JiraProjectMapping  @relation(fields: [organizationId, mappingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy  OrganizationMember? @relation("JiraSyncRequestedBy", fields: [organizationId, requestedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  failures     JiraSyncFailure[]

  @@unique([organizationId, id])
  @@unique([organizationId, mappingId], map: "jira_sync_runs_active_key", where: raw("status = ANY (ARRAY['QUEUED'::\"JiraSyncRunStatus\", 'RUNNING'::\"JiraSyncRunStatus\"])"))
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, mappingId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("jira_sync_runs")
}

/// Per-record failures of a run; messages are sanitized (no tokens, no Jira response bodies).
model JiraSyncFailure {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  runId          String           @map("run_id") @db.Uuid
  jiraIssueId    String?          @map("jira_issue_id")
  errorCode      String           @map("error_code")
  classification JiraFailureClass
  message        String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  run          JiraSyncRun  @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, runId, createdAt])
  @@map("jira_sync_failures")
}

/// Dynamic webhooks registered for a connection (30-day expiry, refreshed before it).
model JiraWebhookRegistration {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  connectionId    String    @map("connection_id") @db.Uuid
  jiraWebhookId   String    @map("jira_webhook_id")
  jqlFilter       String    @map("jql_filter")
  events          String[]
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  lastRefreshedAt DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection   JiraConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, connectionId, jiraWebhookId])
  @@index([expiresAt])
  @@map("jira_webhook_registrations")
}

/// Verified inbound webhook deliveries, deduplicated by Jira's delivery identifier. Payloads keep
/// identifiers only.
model JiraWebhookDelivery {
  id               String                    @id @default(uuid(7)) @db.Uuid
  organizationId   String                    @map("organization_id") @db.Uuid
  connectionId     String                    @map("connection_id") @db.Uuid
  /// `X-Atlassian-Webhook-Identifier` (stable across Jira retries) or a SHA-256 fallback.
  deliveryKey      String                    @map("delivery_key")
  eventType        String                    @map("event_type")
  jiraIssueId      String?                   @map("jira_issue_id")
  jiraProjectId    String?                   @map("jira_project_id")
  webhookTimestamp DateTime?                 @map("webhook_timestamp") @db.Timestamptz(6)
  retryCount       Int                       @default(0) @map("retry_count")
  status           JiraWebhookDeliveryStatus @default(RECEIVED)
  outcome          String?
  errorCode        String?                   @map("error_code")
  payload          Json                      @default("{}")
  receivedAt       DateTime                  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime?                 @map("processed_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection   JiraConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, connectionId, deliveryKey])
  @@index([organizationId, status, receivedAt(sort: Desc)])
  @@map("jira_webhook_deliveries")
}

/// Support ticket ↔ Jira issue. Ticket and issue states stay separate; links never change either.
model SupportTicketJiraLink {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  ticketId          String               @map("ticket_id") @db.Uuid
  /// `jira_issues.id` (our row), not Jira's id.
  issueId           String               @map("issue_id") @db.Uuid
  linkType          TicketJiraLinkType   @map("link_type")
  createdVia        TicketJiraLinkSource @map("created_via")
  createdByMemberId String?              @map("created_by_member_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket       SupportTicket       @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  issue        JiraIssue           @relation(fields: [organizationId, issueId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember? @relation("TicketJiraLinkCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, ticketId, issueId])
  @@index([organizationId, issueId])
  @@map("support_ticket_jira_links")
}

/// Reservation for "Create Jira issue from ticket" (Jira has no idempotency key): one row per
/// ticket and client key, so a double submit never creates two issues.
model JiraIssueCreateRequest {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  ticketId            String                  @map("ticket_id") @db.Uuid
  idempotencyKey      String                  @map("idempotency_key") @db.Uuid
  mappingId           String                  @map("mapping_id") @db.Uuid
  requestedByMemberId String                  @map("requested_by_member_id") @db.Uuid
  requestHash         String                  @map("request_hash")
  status              JiraCreateRequestStatus @default(PENDING)
  jiraIssueId         String?                 @map("jira_issue_id")
  linkId              String?                 @map("link_id") @db.Uuid
  errorCode           String?                 @map("error_code")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket       SupportTicket      @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  mapping      JiraProjectMapping @relation(fields: [organizationId, mappingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy  OrganizationMember @relation("JiraCreateRequestedBy", fields: [organizationId, requestedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, ticketId, idempotencyKey])
  @@map("jira_issue_create_requests")
}

// ---------------------------------------------------------------------------------------------
// Phase 5 — technical-record retention (DATA_MODEL §3, ADR-0020). No row = nothing is purged.
// Phase 7 adds attendance coordinates (nulled, never deleted; ADR-0022).
// ---------------------------------------------------------------------------------------------

enum RetentionCategory {
  /// Processed/ignored/failed Jira and GitHub webhook delivery records (dedupe rows).
  WEBHOOK_DELIVERIES
  /// Jira and GitHub per-record sync failure records.
  SYNC_FAILURES
  /// Latitude/longitude/accuracy on attendance events (the events themselves are kept).
  ATTENDANCE_COORDINATES
}

enum RetentionAction {
  DELETE_ROWS
  NULL_COORDINATES
}

model RetentionPolicy {
  id                   String            @id @default(uuid(7)) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  category             RetentionCategory
  retainDays           Int               @map("retain_days")
  action               RetentionAction   @default(DELETE_ROWS)
  configuredByMemberId String?           @map("configured_by_member_id") @db.Uuid
  configuredAt         DateTime          @default(now()) @map("configured_at") @db.Timestamptz(6)
  /// Last purge pass for this category (rows removed in it), for the admin screen.
  lastPurgedAt         DateTime?         @map("last_purged_at") @db.Timestamptz(6)
  lastPurgedCount      Int?              @map("last_purged_count")
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  configuredBy OrganizationMember? @relation("RetentionConfiguredBy", fields: [organizationId, configuredByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, category])
  @@map("retention_policies")
}

// ---------------------------------------------------------------------------------------------
// Phase 5 — GitHub App (DATA_MODEL §9, ADR-0020). GitHub owns repositories and pull requests;
// these tables are a rebuildable metadata cache plus our own installation bindings, mappings,
// links, runs and delivery records. No source code, diffs, file contents or commit history.
// ---------------------------------------------------------------------------------------------

enum GithubInstallationStatus {
  ACTIVE
  /// Suspended on GitHub; nothing syncs until it is unsuspended.
  SUSPENDED
  /// Uninstalled on GitHub; repositories become unavailable, history stays.
  DELETED
  /// Unbound by an administrator here; the GitHub installation itself is untouched.
  DISCONNECTED
}

enum GithubAccountType {
  ORGANIZATION
  USER
  ENTERPRISE
}

enum GithubRepositorySelection {
  ALL
  SELECTED
}

enum GithubRepositoryStatus {
  AVAILABLE
  /// The installation lost access (repository removed from it, installation deleted or unbound).
  REMOVED
  /// Deleted on GitHub.
  DELETED
}

enum GithubSyncState {
  NOT_STARTED
  RUNNING
  COMPLETED
  FAILED
}

enum GithubPullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum GithubReviewState {
  NONE
  REVIEW_REQUIRED
  CHANGES_REQUESTED
  APPROVED
}

enum GithubChecksState {
  UNKNOWN
  PENDING
  SUCCESS
  FAILURE
}

enum GithubPrJiraLinkSource {
  MANUAL
  BRANCH_NAME
  TITLE
  BODY
}

enum GithubPrJiraLinkState {
  SUGGESTED
  CONFIRMED
  /// Rejected by a person; inference never recreates it.
  DISMISSED
}

enum GithubWebhookDeliveryStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum GithubSyncRunType {
  INITIAL_SYNC
  RECONCILIATION
  MANUAL_RESYNC
}

enum GithubSyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum GithubFailureClass {
  RETRYABLE
  PERMANENT
}

/// A GitHub App installation bound to exactly one organization. The binding is created only after
/// the installing user's GitHub identity is proven to have access to the installation.
model GithubInstallation {
  id                   String                    @id @default(uuid(7)) @db.Uuid
  organizationId       String                    @map("organization_id") @db.Uuid
  /// GitHub's immutable installation id; globally unique (one organization per installation).
  githubInstallationId BigInt                    @map("github_installation_id")
  accountId            BigInt                    @map("account_id")
  accountLogin         String                    @map("account_login")
  accountType          GithubAccountType         @map("account_type")
  repositorySelection  GithubRepositorySelection @map("repository_selection")
  /// Permissions GitHub reports as granted (`{ name: read|write }`), for the admin screen.
  permissions          Json                      @default("{}")
  events               String[]                  @default([])
  status               GithubInstallationStatus  @default(ACTIVE)
  suspendedAt          DateTime?                 @map("suspended_at") @db.Timestamptz(6)
  installedByMemberId  String?                   @map("installed_by_member_id") @db.Uuid
  boundAt              DateTime                  @default(now()) @map("bound_at") @db.Timestamptz(6)
  /// Last successful repository discovery.
  lastSyncedAt         DateTime?                 @map("last_synced_at") @db.Timestamptz(6)
  lastErrorCode        String?                   @map("last_error_code")
  lastErrorAt          DateTime?                 @map("last_error_at") @db.Timestamptz(6)
  deletedAt            DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  disconnectedAt       DateTime?                 @map("disconnected_at") @db.Timestamptz(6)
  version              Int                       @default(1)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  installedBy  OrganizationMember?     @relation("GithubInstalledBy", fields: [organizationId, installedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  repositories GithubRepository[]
  deliveries   GithubWebhookDelivery[]
  syncRuns     GithubSyncRun[]

  @@unique([organizationId, id])
  @@unique([githubInstallationId])
  @@index([status])
  @@map("github_installations")
}

/// Repository metadata, identified by GitHub's immutable repository id (renames update the row).
model GithubRepository {
  id               String                 @id @default(uuid(7)) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  installationId   String                 @map("installation_id") @db.Uuid
  githubRepoId     BigInt                 @map("github_repo_id")
  nodeId           String                 @map("node_id")
  ownerLogin       String                 @map("owner_login")
  name             String
  fullName         String                 @map("full_name")
  private          Boolean
  archived         Boolean                @default(false)
  defaultBranch    String?                @map("default_branch")
  htmlUrl          String                 @map("html_url")
  status           GithubRepositoryStatus @default(AVAILABLE)
  unavailableAt    DateTime?              @map("unavailable_at") @db.Timestamptz(6)
  syncState        GithubSyncState        @default(NOT_STARTED) @map("sync_state")
  lastFullSyncAt   DateTime?              @map("last_full_sync_at") @db.Timestamptz(6)
  lastReconciledAt DateTime?              @map("last_reconciled_at") @db.Timestamptz(6)
  /// Latest pull-request activity seen (GitHub `updated_at`).
  lastActivityAt   DateTime?              @map("last_activity_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  installation GithubInstallation        @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  mappings     GithubRepositoryMapping[]
  pullRequests GithubPullRequest[]
  syncRuns     GithubSyncRun[]

  @@unique([organizationId, id])
  @@unique([organizationId, githubRepoId])
  @@index([organizationId, installationId, status])
  @@index([organizationId, fullName])
  @@map("github_repositories")
}

/// Project ↔ repository (many-to-many). Removal is soft so history and links stay coherent.
model GithubRepositoryMapping {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  repositoryId      String    @map("repository_id") @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  createdByMemberId String?   @map("created_by_member_id") @db.Uuid
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(6)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  repository   GithubRepository    @relation(fields: [organizationId, repositoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  project      Project             @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember? @relation("GithubMappingCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, repositoryId, projectId])
  @@index([organizationId, projectId])
  @@map("github_repository_mappings")
}

/// Pull-request metadata cache (rebuildable). Never source, diffs, file lists or commit history.
model GithubPullRequest {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  repositoryId       String                 @map("repository_id") @db.Uuid
  githubPrId         BigInt                 @map("github_pr_id")
  nodeId             String                 @map("node_id")
  number             Int
  title              String
  state              GithubPullRequestState
  draft              Boolean                @default(false)
  authorLogin        String?                @map("author_login")
  headRef            String                 @map("head_ref")
  baseRef            String                 @map("base_ref")
  headSha            String                 @map("head_sha")
  reviewState        GithubReviewState      @default(NONE) @map("review_state")
  /// Pending review requests: user logins and `team:<slug>`.
  requestedReviewers String[]               @default([]) @map("requested_reviewers")
  checksState        GithubChecksState      @default(UNKNOWN) @map("checks_state")
  checksTotal        Int                    @default(0) @map("checks_total")
  checksFailed       Int                    @default(0) @map("checks_failed")
  checksPending      Int                    @default(0) @map("checks_pending")
  htmlUrl            String                 @map("html_url")
  ghCreatedAt        DateTime               @map("gh_created_at") @db.Timestamptz(6)
  /// Out-of-order guard for the PR fields: an older `updated_at` never overwrites a newer one.
  ghUpdatedAt        DateTime               @map("gh_updated_at") @db.Timestamptz(6)
  mergedAt           DateTime?              @map("merged_at") @db.Timestamptz(6)
  closedAt           DateTime?              @map("closed_at") @db.Timestamptz(6)
  /// Jira-looking keys found in the branch name, title and (capped) body.
  jiraKeys           String[]               @default([]) @map("jira_keys")
  /// Head commit the review/check summary was computed for, and when that fetch started (guard).
  detailsSha         String?                @map("details_sha")
  detailsFetchedAt   DateTime?              @map("details_fetched_at") @db.Timestamptz(6)
  lastSyncedAt       DateTime               @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  repository   GithubRepository          @relation(fields: [organizationId, repositoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  jiraLinks    GithubPrJiraLink[]
  ticketLinks  SupportTicketGithubLink[]

  @@unique([organizationId, id])
  @@unique([organizationId, repositoryId, githubPrId])
  @@unique([organizationId, repositoryId, number])
  @@index([organizationId, repositoryId, state])
  @@index([organizationId, state, reviewState])
  @@index([organizationId, repositoryId, headSha])
  @@index([jiraKeys], type: Gin)
  @@map("github_pull_requests")
}

/// Pull request ↔ cached Jira issue. Inferred links are SUGGESTED or (when verified) CONFIRMED.
model GithubPrJiraLink {
  id                String                 @id @default(uuid(7)) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  pullRequestId     String                 @map("pull_request_id") @db.Uuid
  /// `jira_issues.id` (our row), never a key typed by someone.
  issueId           String                 @map("issue_id") @db.Uuid
  source            GithubPrJiraLinkSource
  state             GithubPrJiraLinkState
  /// Who confirmed, linked or dismissed it; null for automatic confirmation.
  decidedByMemberId String?                @map("decided_by_member_id") @db.Uuid
  decidedAt         DateTime?              @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pullRequest  GithubPullRequest   @relation(fields: [organizationId, pullRequestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  issue        JiraIssue           @relation(fields: [organizationId, issueId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy    OrganizationMember? @relation("GithubPrJiraLinkDecidedBy", fields: [organizationId, decidedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, pullRequestId, issueId])
  @@index([organizationId, issueId, state])
  @@map("github_pr_jira_links")
}

/// Verified webhook deliveries, deduplicated by `X-GitHub-Delivery` (stable across redeliveries).
/// Only identifiers are kept, never the payload.
model GithubWebhookDelivery {
  id             String                      @id @default(uuid(7)) @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  installationId String                      @map("installation_id") @db.Uuid
  deliveryId     String                      @map("delivery_id")
  event          String
  action         String?
  githubRepoId   BigInt?                     @map("github_repo_id")
  prNumber       Int?                        @map("pr_number")
  headSha        String?                     @map("head_sha")
  status         GithubWebhookDeliveryStatus @default(RECEIVED)
  outcome        String?
  errorCode      String?                     @map("error_code")
  receivedAt     DateTime                    @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime?                   @map("processed_at") @db.Timestamptz(6)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  installation GithubInstallation @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([deliveryId])
  @@index([organizationId, status, receivedAt(sort: Desc)])
  @@index([organizationId, receivedAt])
  @@map("github_webhook_deliveries")
}

/// Initial sync and reconciliation runs of one repository. At most one QUEUED/RUNNING run each.
model GithubSyncRun {
  id                  String              @id @default(uuid(7)) @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  installationId      String              @map("installation_id") @db.Uuid
  repositoryId        String              @map("repository_id") @db.Uuid
  type                GithubSyncRunType
  status              GithubSyncRunStatus @default(QUEUED)
  cancelRequested     Boolean             @default(false) @map("cancel_requested")
  requestedByMemberId String?             @map("requested_by_member_id") @db.Uuid
  requestId           String?             @map("request_id")
  startedAt           DateTime?           @map("started_at") @db.Timestamptz(6)
  finishedAt          DateTime?           @map("finished_at") @db.Timestamptz(6)
  recordsProcessed    Int                 @default(0) @map("records_processed")
  recordsCreated      Int                 @default(0) @map("records_created")
  recordsUpdated      Int                 @default(0) @map("records_updated")
  recordsUnchanged    Int                 @default(0) @map("records_unchanged")
  recordsFailed       Int                 @default(0) @map("records_failed")
  pages               Int                 @default(0)
  consecutiveErrors   Int                 @default(0) @map("consecutive_errors")
  /// Durable checkpoint `{ phase, page, since? }`.
  lastCursor          Json                @default("{}") @map("last_cursor")
  errorCode           String?             @map("error_code")
  errorSummary        String?             @map("error_summary")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  installation GithubInstallation  @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  repository   GithubRepository    @relation(fields: [organizationId, repositoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy  OrganizationMember? @relation("GithubSyncRequestedBy", fields: [organizationId, requestedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  failures     GithubSyncFailure[]

  @@unique([organizationId, id])
  @@unique([organizationId, repositoryId], map: "github_sync_runs_active_key", where: raw("status = ANY (ARRAY['QUEUED'::\"GithubSyncRunStatus\", 'RUNNING'::\"GithubSyncRunStatus\"])"))
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, repositoryId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("github_sync_runs")
}

/// Per-record failures of a run; messages are sanitized (no tokens, no GitHub response bodies).
model GithubSyncFailure {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  runId          String             @map("run_id") @db.Uuid
  prNumber       Int?               @map("pr_number")
  errorCode      String             @map("error_code")
  classification GithubFailureClass
  message        String
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  run          GithubSyncRun @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, runId, createdAt])
  @@index([organizationId, createdAt])
  @@map("github_sync_failures")
}

/// Direct support ticket ↔ pull request link (manual). PRs reached through the ticket's Jira links
/// are derived when read and never stored here.
model SupportTicketGithubLink {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  ticketId          String   @map("ticket_id") @db.Uuid
  pullRequestId     String   @map("pull_request_id") @db.Uuid
  createdByMemberId String?  @map("created_by_member_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket       SupportTicket       @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  pullRequest  GithubPullRequest   @relation(fields: [organizationId, pullRequestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember? @relation("TicketGithubLinkCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, ticketId, pullRequestId])
  @@index([organizationId, pullRequestId])
  @@map("support_ticket_github_links")
}

// ---------------------------------------------------------------------------------------------
// Phase 6: requests and approvals (ADR-0021). One generic engine: request types are configuration,
// workflows are versioned, requests pin the version they were submitted with.
// ---------------------------------------------------------------------------------------------

enum RequestCategory {
  HR
  IT
  FINANCE
  ACCESS
  OPERATIONS
  OTHER
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum WorkflowStepKind {
  APPROVAL
  FULFILLMENT
}

enum ApproverType {
  DIRECT_MANAGER
  DEPARTMENT_MANAGER
  TEAM_LEAD
  PROJECT_MANAGER
  TECHNICAL_MANAGER
  ROLE
  MEMBER
}

enum ApprovalMode {
  ANY_ONE
  ALL
}

enum AttachmentRequirement {
  NONE
  OPTIONAL
  REQUIRED
}

enum RequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  IN_FULFILLMENT
  COMPLETED
}

enum RequestApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum RequestEffectKind {
  ATTENDANCE
}

enum RequestEffectMode {
  LEAVE
  REMOTE
  BUSINESS_MISSION
  SHORT_LEAVE
  /// Attendance correction (reserved type `attendance_correction` only, ADR-0022).
  CORRECTION
}

enum RequestEffectStatus {
  RECORDED
  REVOKED
}

/// Requester-facing configuration (not versioned). Exactly one workflow definition per type.
model RequestType {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  /// Lowercase slug (CHECK), unique per organization.
  key               String
  /// `{ en, ar? }`
  name              Json
  /// `{ en, ar? }`
  description       Json?
  category          RequestCategory
  icon              String
  active            Boolean         @default(false)
  createdByMemberId String?         @map("created_by_member_id") @db.Uuid
  version           Int             @default(1)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      OrganizationMember?  @relation("RequestTypeCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requesterRoles RequestTypeRole[]
  definition     WorkflowDefinition?
  requests       RequestInstance[]
  delegations    ApprovalDelegation[]

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, active])
  @@map("request_types")
}

/// Requester eligibility: when a type has rows here, only members holding one of these roles may submit it.
model RequestTypeRole {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestTypeId  String   @map("request_type_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestType  RequestType  @relation(fields: [organizationId, requestTypeId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, requestTypeId, roleId])
  @@index([organizationId, roleId])
  @@map("request_type_roles")
}

/// 1:1 with a request type. `version` serializes draft creation and publishing.
model WorkflowDefinition {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestTypeId  String   @map("request_type_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestType  RequestType       @relation(fields: [organizationId, requestTypeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  versions     WorkflowVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, requestTypeId])
  @@map("workflow_definitions")
}

/// Form schema, attachment policy, effects, notification behavior and steps, versioned together.
/// PUBLISHED and RETIRED versions are immutable (trigger); only PUBLISHED -> RETIRED is allowed.
model WorkflowVersion {
  id                    String                @id @default(uuid(7)) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  definitionId          String                @map("definition_id") @db.Uuid
  number                Int
  status                WorkflowVersionStatus @default(DRAFT)
  formSchema            Json                  @map("form_schema")
  attachmentRequirement AttachmentRequirement @default(NONE) @map("attachment_requirement")
  maxAttachments        Int                   @default(5) @map("max_attachments") @db.SmallInt
  effects               Json                  @default("{}")
  emailApprovers        Boolean               @default(true) @map("email_approvers")
  emailRequester        Boolean               @default(true) @map("email_requester")
  /// Draft edit counter (optimistic concurrency of the builder).
  revision              Int                   @default(1)
  createdByMemberId     String?               @map("created_by_member_id") @db.Uuid
  publishedAt           DateTime?             @map("published_at") @db.Timestamptz(6)
  publishedByMemberId   String?               @map("published_by_member_id") @db.Uuid
  retiredAt             DateTime?             @map("retired_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  definition   WorkflowDefinition  @relation(fields: [organizationId, definitionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember? @relation("WorkflowVersionCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  publishedBy  OrganizationMember? @relation("WorkflowVersionPublishedBy", fields: [organizationId, publishedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  steps        WorkflowStep[]
  requests     RequestInstance[]
  effectsOf    RequestEffect[]

  @@unique([organizationId, id])
  @@unique([organizationId, definitionId, number])
  @@unique([organizationId, definitionId], map: "workflow_versions_one_draft_key", where: raw("status = 'DRAFT'::\"WorkflowVersionStatus\""))
  @@unique([organizationId, definitionId], map: "workflow_versions_one_published_key", where: raw("status = 'PUBLISHED'::\"WorkflowVersionStatus\""))
  @@map("workflow_versions")
}

/// Ordered approval and fulfillment steps of a version. Changeable only while the version is a DRAFT (trigger).
model WorkflowStep {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  versionId        String           @map("version_id") @db.Uuid
  stepOrder        Int              @map("step_order") @db.SmallInt
  kind             WorkflowStepKind
  /// `{ en, ar? }`
  name             Json
  mode             ApprovalMode     @default(ANY_ONE)
  approverType     ApproverType?    @map("approver_type")
  approverMemberId String?          @map("approver_member_id") @db.Uuid
  approverRoleId   String?          @map("approver_role_id") @db.Uuid
  /// Key of the `project` form field for PROJECT_MANAGER / TECHNICAL_MANAGER.
  projectField     String?          @map("project_field")
  /// Declarative condition tree (ADR-0021); null = always applies.
  condition        Json?
  slaHours         Int?             @map("sla_hours") @db.SmallInt
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version        WorkflowVersion     @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  approverMember OrganizationMember? @relation("WorkflowStepApprover", fields: [organizationId, approverMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approverRole   Role?               @relation(fields: [organizationId, approverRoleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approvals      RequestApproval[]

  @@unique([organizationId, id])
  @@unique([organizationId, versionId, stepOrder])
  @@index([organizationId, approverMemberId])
  @@index([organizationId, approverRoleId])
  @@map("workflow_steps")
}

/// A request. The workflow version, form data, type, requester and number are immutable once it left DRAFT (trigger).
model RequestInstance {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  number            Int
  requestTypeId     String        @map("request_type_id") @db.Uuid
  workflowVersionId String        @map("workflow_version_id") @db.Uuid
  requesterMemberId String        @map("requester_member_id") @db.Uuid
  /// From the first `project` form field; drives PROJECT scope and project approver rules.
  projectId         String?       @map("project_id") @db.Uuid
  status            RequestStatus @default(DRAFT)
  formData          Json          @default("{}") @map("form_data")
  /// Applicable step orders, fixed at submission from the immutable form data.
  route             Int[]         @default([]) @db.SmallInt
  currentStepOrder  Int?          @map("current_step_order") @db.SmallInt
  startsOn          DateTime?     @map("starts_on") @db.Date
  endsOn            DateTime?     @map("ends_on") @db.Date
  submittedAt       DateTime?     @map("submitted_at") @db.Timestamptz(6)
  decidedAt         DateTime?     @map("decided_at") @db.Timestamptz(6)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?       @map("cancel_reason")
  /// Client-generated key of the create request (`Idempotency-Key`), unique per requester.
  idempotencyKey    String?       @map("idempotency_key") @db.Uuid
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestType           RequestType                   @relation(fields: [organizationId, requestTypeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  workflowVersion       WorkflowVersion               @relation(fields: [organizationId, workflowVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requester             OrganizationMember            @relation("RequestRequester", fields: [organizationId, requesterMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  project               Project?                      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approvals             RequestApproval[]
  events                RequestEvent[]
  effects               RequestEffect[]
  attendanceRecords     AttendanceRecord[]            @relation("AttendanceRecordSourceRequest")
  attendanceEvents      AttendanceEvent[]             @relation("AttendanceEventRequest")
  attendanceAdjustments AttendanceAdjustmentRequest[] @relation("AttendanceAdjustmentRequest")

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, requesterMemberId, idempotencyKey])
  @@index([organizationId, requesterMemberId, status])
  @@index([organizationId, requesterMemberId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, status, submittedAt])
  @@index([organizationId, requestTypeId, startsOn, endsOn])
  @@index([organizationId, workflowVersionId])
  @@index([organizationId, projectId])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("request_instances")
}

/// One assignment per approver of an activated step, frozen at activation. The original approver
/// stays in `approver_member_id`; a delegate acting records `decided_by_member_id` and `delegation_id`.
model RequestApproval {
  id                String                @id @default(uuid(7)) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  requestId         String                @map("request_id") @db.Uuid
  stepId            String                @map("step_id") @db.Uuid
  stepOrder         Int                   @map("step_order") @db.SmallInt
  approverMemberId  String                @map("approver_member_id") @db.Uuid
  status            RequestApprovalStatus @default(PENDING)
  decidedByMemberId String?               @map("decided_by_member_id") @db.Uuid
  delegationId      String?               @map("delegation_id") @db.Uuid
  comment           String?
  decidedAt         DateTime?             @map("decided_at") @db.Timestamptz(6)
  dueAt             DateTime?             @map("due_at") @db.Timestamptz(6)
  remindedAt        DateTime?             @map("reminded_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  request      RequestInstance     @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  step         WorkflowStep        @relation(fields: [organizationId, stepId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approver     OrganizationMember  @relation("RequestApprovalApprover", fields: [organizationId, approverMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy    OrganizationMember? @relation("RequestApprovalDecidedBy", fields: [organizationId, decidedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  delegation   ApprovalDelegation? @relation(fields: [organizationId, delegationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, requestId, stepOrder, approverMemberId])
  @@index([organizationId, approverMemberId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, requestId, stepOrder])
  @@index([organizationId, stepId])
  @@index([organizationId, decidedByMemberId])
  @@index([organizationId, delegationId])
  @@index([organizationId, dueAt], map: "request_approvals_due_idx", where: raw("status = 'PENDING'::\"RequestApprovalStatus\" AND reminded_at IS NULL AND due_at IS NOT NULL"))
  @@map("request_approvals")
}

/// Approval delegation for a period, optionally limited to one request type. Not transitive.
model ApprovalDelegation {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  delegatorMemberId String    @map("delegator_member_id") @db.Uuid
  delegateMemberId  String    @map("delegate_member_id") @db.Uuid
  requestTypeId     String?   @map("request_type_id") @db.Uuid
  startsAt          DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime  @map("ends_at") @db.Timestamptz(6)
  reason            String?
  createdByMemberId String    @map("created_by_member_id") @db.Uuid
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByMemberId String?   @map("revoked_by_member_id") @db.Uuid
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  delegator    OrganizationMember  @relation("DelegationDelegator", fields: [organizationId, delegatorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  delegate     OrganizationMember  @relation("DelegationDelegate", fields: [organizationId, delegateMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requestType  RequestType?        @relation(fields: [organizationId, requestTypeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember  @relation("DelegationCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy    OrganizationMember? @relation("DelegationRevokedBy", fields: [organizationId, revokedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approvals    RequestApproval[]

  @@unique([organizationId, id])
  @@index([organizationId, delegatorMemberId, endsAt])
  @@index([organizationId, delegateMemberId, endsAt])
  @@index([organizationId, requestTypeId])
  @@index([organizationId, createdByMemberId])
  @@index([organizationId, revokedByMemberId])
  @@map("approval_delegations")
}

/// Append-only request history (UPDATE/DELETE/TRUNCATE blocked by trigger and grants), separate from audit.
model RequestEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  /// Null for system changes (worker).
  actorMemberId  String?  @map("actor_member_id") @db.Uuid
  type           String
  stepOrder      Int?     @map("step_order") @db.SmallInt
  /// Identifiers, enum values and the decision comment only.
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  request        RequestInstance     @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actorMember    OrganizationMember? @relation(fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedEffects RequestEffect[]     @relation("RequestEffectDecision")
  revokedEffects RequestEffect[]     @relation("RequestEffectRevocation")

  @@unique([organizationId, id])
  @@index([organizationId, requestId, createdAt, id])
  @@index([organizationId, actorMemberId])
  @@map("request_events")
}

/// Trusted effect of an approved request, consumed by later modules (Phase 7 attendance). One per request and kind.
model RequestEffect {
  id                String              @id @default(uuid(7)) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  requestId         String              @map("request_id") @db.Uuid
  kind              RequestEffectKind
  mode              RequestEffectMode
  startsOn          DateTime            @map("starts_on") @db.Date
  endsOn            DateTime            @map("ends_on") @db.Date
  /// SHORT_LEAVE window in local minutes (Phase 7, ADR-0022); null = the whole day.
  startsAtMinute    Int?                @map("starts_at_minute") @db.SmallInt
  endsAtMinute      Int?                @map("ends_at_minute") @db.SmallInt
  workflowVersionId String              @map("workflow_version_id") @db.Uuid
  decisionEventId   String              @map("decision_event_id") @db.Uuid
  status            RequestEffectStatus @default(RECORDED)
  revokedAt         DateTime?           @map("revoked_at") @db.Timestamptz(6)
  revokeEventId     String?             @map("revoke_event_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  request          RequestInstance   @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  workflowVersion  WorkflowVersion   @relation(fields: [organizationId, workflowVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  decisionEvent    RequestEvent      @relation("RequestEffectDecision", fields: [organizationId, decisionEventId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  revokeEvent      RequestEvent?     @relation("RequestEffectRevocation", fields: [organizationId, revokeEventId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  attendanceEvents AttendanceEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, requestId, kind])
  @@index([organizationId, kind, status, startsOn])
  @@index([organizationId, workflowVersionId])
  @@index([organizationId, decisionEventId])
  @@index([organizationId, revokeEventId])
  @@map("request_effects")
}

// ---------------------------------------------------------------------------------------------
// Phase 7 — Attendance (DATA_MODEL "Phase 7 — Attendance", ADR-0022). Work locations are the
// Phase 2 rows. Events are append-only evidence; records are derived state rebuilt from events,
// the shift snapshot and active request effects. No continuous location tracking exists.
// ---------------------------------------------------------------------------------------------

enum AttendanceAccuracyAction {
  FLAG_FOR_REVIEW
  REJECT
}

enum AttendanceMode {
  OFFICE
  SITE
  REMOTE
  BUSINESS_MISSION
  LEAVE
}

enum AttendanceRecordStatus {
  OPEN
  COMPLETE
  MISSING_CHECKOUT
  EXCUSED
  ABSENT
  /// Nothing recorded yet for a day that is not over (never shown as absent).
  SCHEDULED
}

enum AttendanceEventKind {
  CHECK_IN
  CHECK_OUT
  ADJUSTED
  ADJUSTMENT_REVERTED
  SYSTEM_MISSING_CHECKOUT
  EFFECT_APPLIED
  EFFECT_REVOKED
}

enum AttendanceGeofenceResult {
  INSIDE
  OUTSIDE
  LOW_ACCURACY
  NOT_REQUIRED
  PERMISSION_DENIED
  UNAVAILABLE
}

enum AttendanceReviewStatus {
  NOT_REQUIRED
  PENDING_REVIEW
  ACCEPTED
  REJECTED
}

enum AttendanceAdjustmentReason {
  FORGOT_CHECK_IN
  FORGOT_CHECK_OUT
  WRONG_LOCATION
  SYSTEM_ISSUE
  INCORRECT_TIME
}

/// Accuracy and missing-location policy (SECURITY §9). No row = location check-ins are refused
/// (`ATTENDANCE_NOT_CONFIGURED`): no code default is treated as policy.
model AttendancePolicy {
  id                          String                   @id @default(uuid(7)) @db.Uuid
  organizationId              String                   @map("organization_id") @db.Uuid
  maxAccuracyMeters           Int                      @map("max_accuracy_meters")
  lowAccuracyAction           AttendanceAccuracyAction @map("low_accuracy_action")
  missingLocationAction       AttendanceAccuracyAction @default(REJECT) @map("missing_location_action")
  missingCheckoutAfterMinutes Int                      @default(240) @map("missing_checkout_after_minutes")
  configuredByMemberId        String?                  @map("configured_by_member_id") @db.Uuid
  version                     Int                      @default(1)
  createdAt                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  configuredBy OrganizationMember? @relation("AttendancePolicyConfiguredBy", fields: [organizationId, configuredByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId])
  @@unique([organizationId, id])
  @@map("attendance_policies")
}

/// Working hours in local wall time. Deactivated, never deleted; records snapshot what they used.
model Shift {
  id                     String   @id @default(uuid(7)) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  name                   String   @db.Citext
  /// Minutes since local midnight (0-1439).
  startMinute            Int      @map("start_minute") @db.SmallInt
  endMinute              Int      @map("end_minute") @db.SmallInt
  /// True exactly when the shift ends on the next local day (CHECK: end <= start).
  crossesMidnight        Boolean  @map("crosses_midnight")
  lateGraceMinutes       Int      @default(0) @map("late_grace_minutes") @db.SmallInt
  earlyLeaveGraceMinutes Int      @default(0) @map("early_leave_grace_minutes") @db.SmallInt
  /// ISO weekdays (1 = Monday ... 7 = Sunday) on which the shift starts.
  weekdays               Int[]    @db.SmallInt
  active                 Boolean  @default(true)
  version                Int      @default(1)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments  EmployeeShiftAssignment[]
  records      AttendanceRecord[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("shifts")
}

/// Which shift applies to an employee and when. Overlaps are rejected by a GiST exclusion constraint.
model EmployeeShiftAssignment {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  profileId         String    @map("profile_id") @db.Uuid
  shiftId           String    @map("shift_id") @db.Uuid
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  /// Inclusive; null = open-ended.
  effectiveTo       DateTime? @map("effective_to") @db.Date
  createdByMemberId String?   @map("created_by_member_id") @db.Uuid
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  profile      EmployeeProfile     @relation(fields: [organizationId, profileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  shift        Shift               @relation(fields: [organizationId, shiftId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    OrganizationMember? @relation("ShiftAssignmentCreatedBy", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, profileId, effectiveFrom])
  @@index([organizationId, shiftId])
  @@index([organizationId, createdByMemberId])
  @@map("employee_shift_assignments")
}

/// Derived daily state, one per employee and local work date. Never deleted; the shift context is a
/// snapshot taken when the record was created.
model AttendanceRecord {
  id                     String                 @id @default(uuid(7)) @db.Uuid
  organizationId         String                 @map("organization_id") @db.Uuid
  profileId              String                 @map("profile_id") @db.Uuid
  memberId               String                 @map("member_id") @db.Uuid
  workDate               DateTime               @map("work_date") @db.Date
  timeZone               String                 @map("time_zone")
  mode                   AttendanceMode?
  status                 AttendanceRecordStatus @default(OPEN)
  shiftId                String?                @map("shift_id") @db.Uuid
  shiftName              String?                @map("shift_name")
  shiftStartMinute       Int?                   @map("shift_start_minute") @db.SmallInt
  shiftEndMinute         Int?                   @map("shift_end_minute") @db.SmallInt
  shiftCrossesMidnight   Boolean?               @map("shift_crosses_midnight")
  lateGraceMinutes       Int?                   @map("late_grace_minutes") @db.SmallInt
  earlyLeaveGraceMinutes Int?                   @map("early_leave_grace_minutes") @db.SmallInt
  scheduledStartAt       DateTime?              @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt         DateTime?              @map("scheduled_end_at") @db.Timestamptz(6)
  checkInAt              DateTime?              @map("check_in_at") @db.Timestamptz(6)
  checkOutAt             DateTime?              @map("check_out_at") @db.Timestamptz(6)
  checkInLocationId      String?                @map("check_in_location_id") @db.Uuid
  checkOutLocationId     String?                @map("check_out_location_id") @db.Uuid
  lateMinutes            Int                    @default(0) @map("late_minutes")
  earlyLeaveMinutes      Int                    @default(0) @map("early_leave_minutes")
  workedMinutes          Int?                   @map("worked_minutes")
  needsReview            Boolean                @default(false) @map("needs_review")
  adjusted               Boolean                @default(false)
  /// The request whose approved effect shaped the day (leave, remote, mission, short permission).
  sourceRequestId        String?                @map("source_request_id") @db.Uuid
  missingCheckoutAt      DateTime?              @map("missing_checkout_at") @db.Timestamptz(6)
  version                Int                    @default(1)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  profile          EmployeeProfile               @relation(fields: [organizationId, profileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  member           OrganizationMember            @relation("AttendanceRecordMember", fields: [organizationId, memberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  shift            Shift?                        @relation(fields: [organizationId, shiftId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  checkInLocation  WorkLocation?                 @relation("AttendanceCheckInLocation", fields: [organizationId, checkInLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  checkOutLocation WorkLocation?                 @relation("AttendanceCheckOutLocation", fields: [organizationId, checkOutLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceRequest    RequestInstance?              @relation("AttendanceRecordSourceRequest", fields: [organizationId, sourceRequestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  events           AttendanceEvent[]
  adjustments      AttendanceAdjustmentRequest[]

  @@unique([organizationId, id])
  @@unique([organizationId, profileId, workDate])
  @@index([organizationId, workDate, status])
  @@index([organizationId, memberId, workDate(sort: Desc)])
  @@index([organizationId, status, scheduledEndAt])
  @@index([organizationId, shiftId])
  @@index([organizationId, checkInLocationId])
  @@index([organizationId, checkOutLocationId])
  @@index([organizationId, sourceRequestId])
  @@map("attendance_records")
}

/// Append-only evidence (trigger + grants). Only the one-time review decision and the retention
/// function (nulling coordinates) may change a row.
model AttendanceEvent {
  id                      String                      @id @default(uuid(7)) @db.Uuid
  organizationId          String                      @map("organization_id") @db.Uuid
  recordId                String                      @map("record_id") @db.Uuid
  profileId               String                      @map("profile_id") @db.Uuid
  kind                    AttendanceEventKind
  /// Server time the event was recorded.
  recordedAt              DateTime                    @default(now()) @map("recorded_at") @db.Timestamptz(6)
  /// The attendance instant the event asserts (check-in/out time); server time for live events.
  effectiveAt             DateTime?                   @map("effective_at") @db.Timestamptz(6)
  workDate                DateTime                    @map("work_date") @db.Date
  mode                    AttendanceMode?
  workLocationId          String?                     @map("work_location_id") @db.Uuid
  /// Rounded to 5 decimals; nulled by the coordinate retention policy.
  latitude                Decimal?                    @db.Decimal(7, 5)
  longitude               Decimal?                    @db.Decimal(8, 5)
  accuracyMeters          Int?                        @map("accuracy_meters")
  distanceMeters          Int?                        @map("distance_meters")
  allowedRadiusMeters     Int?                        @map("allowed_radius_meters")
  accuracyThresholdMeters Int?                        @map("accuracy_threshold_meters")
  geofenceResult          AttendanceGeofenceResult?   @map("geofence_result")
  reviewStatus            AttendanceReviewStatus      @default(NOT_REQUIRED) @map("review_status")
  reviewedByMemberId      String?                     @map("reviewed_by_member_id") @db.Uuid
  reviewedAt              DateTime?                   @map("reviewed_at") @db.Timestamptz(6)
  reviewNote              String?                     @map("review_note")
  /// Who caused the event: the employee, an administrator, the approver of a correction; null = system.
  actorMemberId           String?                     @map("actor_member_id") @db.Uuid
  requestId               String?                     @map("request_id") @db.Uuid
  requestEffectId         String?                     @map("request_effect_id") @db.Uuid
  adjustmentId            String?                     @map("adjustment_id") @db.Uuid
  previousCheckInAt       DateTime?                   @map("previous_check_in_at") @db.Timestamptz(6)
  previousCheckOutAt      DateTime?                   @map("previous_check_out_at") @db.Timestamptz(6)
  adjustedCheckInAt       DateTime?                   @map("adjusted_check_in_at") @db.Timestamptz(6)
  adjustedCheckOutAt      DateTime?                   @map("adjusted_check_out_at") @db.Timestamptz(6)
  reasonCode              AttendanceAdjustmentReason? @map("reason_code")
  note                    String?
  ipAddress               String?                     @map("ip_address")
  userAgent               String?                     @map("user_agent")
  idempotencyKey          String                      @map("idempotency_key")
  /// Member whose client key this is (null for system keys); replays must come from the same member.
  keyOwnerMemberId        String?                     @map("key_owner_member_id") @db.Uuid

  organization  Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  record        AttendanceRecord             @relation(fields: [organizationId, recordId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  profile       EmployeeProfile              @relation(fields: [organizationId, profileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  workLocation  WorkLocation?                @relation(fields: [organizationId, workLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy    OrganizationMember?          @relation("AttendanceEventReviewedBy", fields: [organizationId, reviewedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actor         OrganizationMember?          @relation("AttendanceEventActor", fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  request       RequestInstance?             @relation("AttendanceEventRequest", fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requestEffect RequestEffect?               @relation(fields: [organizationId, requestEffectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  adjustment    AttendanceAdjustmentRequest? @relation("AttendanceEventAdjustment", fields: [organizationId, adjustmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, recordId, recordedAt, id])
  @@index([organizationId, profileId, recordedAt(sort: Desc)])
  @@index([organizationId, reviewStatus, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([organizationId, workLocationId])
  @@index([organizationId, reviewedByMemberId])
  @@index([organizationId, actorMemberId])
  @@index([organizationId, requestId])
  @@index([organizationId, requestEffectId])
  @@index([organizationId, adjustmentId])
  @@map("attendance_events")
}

/// The attendance side of a correction: trusted, validated requested values plus the originals. The
/// decision is made by the Phase 6 request it references (reserved type `attendance_correction`).
model AttendanceAdjustmentRequest {
  id                  String                     @id @default(uuid(7)) @db.Uuid
  organizationId      String                     @map("organization_id") @db.Uuid
  profileId           String                     @map("profile_id") @db.Uuid
  requesterMemberId   String                     @map("requester_member_id") @db.Uuid
  recordId            String?                    @map("record_id") @db.Uuid
  workDate            DateTime                   @map("work_date") @db.Date
  reasonCode          AttendanceAdjustmentReason @map("reason_code")
  requestedCheckInAt  DateTime?                  @map("requested_check_in_at") @db.Timestamptz(6)
  requestedCheckOutAt DateTime?                  @map("requested_check_out_at") @db.Timestamptz(6)
  originalCheckInAt   DateTime?                  @map("original_check_in_at") @db.Timestamptz(6)
  originalCheckOutAt  DateTime?                  @map("original_check_out_at") @db.Timestamptz(6)
  details             String
  requestId           String                     @map("request_id") @db.Uuid
  appliedAt           DateTime?                  @map("applied_at") @db.Timestamptz(6)
  revertedAt          DateTime?                  @map("reverted_at") @db.Timestamptz(6)
  idempotencyKey      String?                    @map("idempotency_key") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  profile      EmployeeProfile    @relation(fields: [organizationId, profileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requester    OrganizationMember @relation("AttendanceAdjustmentRequester", fields: [organizationId, requesterMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  record       AttendanceRecord?  @relation(fields: [organizationId, recordId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  request      RequestInstance    @relation("AttendanceAdjustmentRequest", fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  events       AttendanceEvent[]  @relation("AttendanceEventAdjustment")

  @@unique([organizationId, id])
  @@unique([organizationId, requestId])
  @@unique([organizationId, requesterMemberId, idempotencyKey])
  @@index([organizationId, profileId, workDate])
  @@index([organizationId, recordId])
  @@map("attendance_adjustment_requests")
}

// ---------------------------------------------------------------------------------------------
