}

/// Tenant root.
model Organization {
  id            String    @id @default(uuid(7)) @db.Uuid
  slug          String    @unique @db.Citext
  name          String
  defaultLocale String    @default("en") @map("default_locale")
  /// IANA zone chosen at creation. No application default (DATA_MODEL §3).
  timeZone      String    @map("time_zone")
  /// ISO weekdays (1 = Monday ... 7 = Sunday) chosen at creation. No application default.
  workWeek      Int[]     @map("work_week") @db.SmallInt
  status        OrgStatus @default(ACTIVE)
  settings      Json      @default("{}")
  setupState    Json      @default("{}") @map("setup_state")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  members               OrganizationMember[]
  roles                 Role[]
  rolePermissions       RolePermission[]
  memberRoles           MemberRole[]
  auditLogs             AuditLog[]
  platformAuditLogs     PlatformAuditLog[]
  departments           Department[]
  jobTitles             JobTitle[]
  teams                 Team[]
  teamMembers           TeamMember[]
  employeeProfiles      EmployeeProfile[]
  invitations           MemberInvitation[]
  counters              OrganizationCounter[]
  attachments           Attachment[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  outboxEvents          OutboxEvent[]
  customers             Customer[]
  projects              Project[]
  projectMembers        ProjectMember[]
  workLocations         WorkLocation[]
  projectLocations      ProjectLocation[]
  dailyReports          DailyReport[]
  projectActivity       ProjectActivity[]
  supportCategories     SupportCategory[]
  supportComponents     SupportComponent[]
  supportTickets        SupportTicket[]
  ticketEvents          SupportTicketEvent[]
  ticketComments        SupportTicketComment[]
  ticketWatchers        SupportTicketWatcher[]
  businessCalendars     BusinessCalendar[]
  slaPolicies           SlaPolicy[]
  escalationRules       EscalationRule[]
  slaEvents             SlaEvent[]
  deliveries            NotificationDelivery[]
  jiraConnections       JiraConnection[]
  jiraMappings          JiraProjectMapping[]
  jiraIssues            JiraIssue[]
  jiraSyncRuns          JiraSyncRun[]
  jiraSyncFailures      JiraSyncFailure[]
  jiraRegistrations     JiraWebhookRegistration[]
  jiraDeliveries        JiraWebhookDelivery[]
  ticketJiraLinks       SupportTicketJiraLink[]
  jiraCreateRequests    JiraIssueCreateRequest[]
  retentionPolicies     RetentionPolicy[]
  githubInstallations   GithubInstallation[]
  githubRepositories    GithubRepository[]
  githubMappings        GithubRepositoryMapping[]
  githubPullRequests    GithubPullRequest[]
  githubPrJiraLinks     GithubPrJiraLink[]
  githubDeliveries      GithubWebhookDelivery[]
  githubSyncRuns        GithubSyncRun[]
  githubSyncFailures    GithubSyncFailure[]
  ticketGithubLinks     SupportTicketGithubLink[]
  requestTypes          RequestType[]
  requestTypeRoles      RequestTypeRole[]
  workflowDefinitions   WorkflowDefinition[]
  workflowVersions      WorkflowVersion[]
  workflowSteps         WorkflowStep[]
  requests              RequestInstance[]
  requestApprovals      RequestApproval[]
  approvalDelegations   ApprovalDelegation[]
  requestEvents         RequestEvent[]
  requestEffects        RequestEffect[]
  attendancePolicies    AttendancePolicy[]
  shifts                Shift[]
  shiftAssignments      EmployeeShiftAssignment[]
  attendanceRecords     AttendanceRecord[]
  attendanceEvents      AttendanceEvent[]
  attendanceAdjustments AttendanceAdjustmentRequest[]
  tenders               Tender[]
  tenderBidDecisions    TenderBidDecisionRecord[]
  tenderRequirements    TenderRequirement[]
  requirementLinks      TenderRequirementLink[]
  tenderReviewGates     TenderReviewGate[]
  tenderReviews         TenderReview[]
  tenderEvents          TenderEvent[]
  tenderAddenda         TenderAddendum[]
  tenderClarifications  TenderClarification[]
  tenderSubmissions     TenderSubmission[]
  commercialDocuments   CommercialDocument[]
  commercialVersions    CommercialDocumentVersion[]
  corporateDocuments    CorporateDocument[]
  corporateVersions     CorporateDocumentVersion[]
  contracts             Contract[]
  contractAmendments    ContractAmendment[]
  contractObligations   ContractObligation[]
  obligationOccurrences ContractObligationOccurrence[]
  contractMilestones    ContractMilestone[]
