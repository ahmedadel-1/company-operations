// Physical schema (docs/DATA_MODEL.md). Changes only through Prisma migrations.
//
// Tenancy (ADR-0003, DATA_MODEL §2): every tenant table carries `organization_id`, declares
// UNIQUE (organization_id, id), and references other tenant tables through composite foreign keys
// (organization_id, x_id) -> parent (organization_id, id), so the database rejects cross-tenant links.
// Global tables: users, platform_audit_logs (and organizations, the tenant root).
//
// Hand-written SQL in migrations (not expressible here): extensions, CHECK constraints,
// append-only triggers and grants. See prisma/migrations/*/migration.sql.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  /// Partial indexes (SLA sweep, exactly-once SLA events) are declared here so drift checks see them (ADR-0018).
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

