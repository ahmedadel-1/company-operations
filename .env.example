# Company Operations Hub - local development configuration.
#
# Placeholders only. Never commit real values. Create your local .env with:
#   pnpm env:init        (copies this file and replaces every __SECRET:<NAME>__ with a random value
#                         and every __KEY32:<NAME>__ with 32 random bytes in base64; the same <NAME>
#                         always receives the same value)
# or copy this file to .env and replace the placeholders by hand, consistently.
#
# Variable names follow docs/DEPLOYMENT.md §6. Variables for later phases (GitHub, Sentry) are added by
# the phase that first reads them.

# --- Runtime ---------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
SWAGGER_ENABLED=true

# --- HTTP / browser origin -------------------------------------------------------------------------
# Browser-facing origin. In development the Next.js dev server proxies /api to the API, so web and
# API share this origin (ARCHITECTURE §6). Keycloak redirect URIs are derived from it.
APP_PUBLIC_URL=http://localhost:3000
# Comma-separated extra origins allowed by CORS and the CSRF Origin check (empty = same-origin only).
CORS_ORIGINS=
# Reverse-proxy hops whose X-Forwarded-* headers are trusted (0 = none). Set it to the number of proxies
# that overwrite X-Forwarded-For in front of the API (production Nginx: 1). The Next.js /api proxy
# strips client forwarding headers, so behind it the API sees the web server as the client IP.
TRUST_PROXY_HOPS=1
# Where the web server forwards /api requests when no reverse proxy routes /api to the API.
API_INTERNAL_URL=http://localhost:4000

# --- Authentication (Keycloak OIDC, ADR-0002) ------------------------------------------------------
OIDC_ISSUER=http://localhost:8080/realms/company-ops
OIDC_CLIENT_ID=ops-api
# Also imported into the dev realm as the ops-api client secret.
OIDC_CLIENT_SECRET=__SECRET:OIDC_CLIENT_SECRET__
# Development only: the local Keycloak is served over http. Must be false in production.
OIDC_ALLOW_INSECURE_HTTP=true
# Keycloak (in Docker) calls the API on the host for back-channel logout.
OIDC_BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:4000/api/v1/auth/backchannel-logout
# Password of every demo user in the dev realm (infra/docker/keycloak/realms). Development only.
KC_DEMO_USER_PASSWORD=__SECRET:KC_DEMO_USER_PASSWORD__

# --- Sessions and encryption (SECURITY §3, §7) -----------------------------------------------------
# AES-256-GCM key for secrets at rest (session-held ID tokens; later integration tokens).
APP_ENCRYPTION_KEY=__KEY32:APP_ENCRYPTION_KEY__
APP_ENCRYPTION_KEY_ID=dev-1
# Key rotation: retired keys still able to decrypt, as comma-separated <id>:<base64 key> pairs.
# The worker needs the same three values as the API when Jira is enabled (it refreshes Jira tokens).
APP_ENCRYPTION_KEYS_PREVIOUS=
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
MFA_MAX_AGE_MINUTES=720

# --- Rate limits (SECURITY §5) ---------------------------------------------------------------------
# Per client IP: every request / sign-in, step-up and callback.
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
# Per authenticated user (shared by all of that user's sessions and IPs).
RATE_LIMIT_USER_PER_MINUTE=240
# Per user: role changes, member status, invitations, organization settings.
RATE_LIMIT_SENSITIVE_PER_MINUTE=20
# Per user: requests that call Jira or queue Jira work (protects the organization's shared Jira quota).
RATE_LIMIT_JIRA_PER_MINUTE=30
# Per user: attachment upload intents.
RATE_LIMIT_UPLOAD_PER_MINUTE=30
# Per user: requests that call GitHub or queue GitHub work (installation setup, resync).
RATE_LIMIT_GITHUB_PER_MINUTE=30
# Per user: attendance check-in and check-out (idempotent retries count too; 10/min never blocks a retry).
RATE_LIMIT_ATTENDANCE_PER_MINUTE=10
# Per user: global search (the command palette debounces typing).
RATE_LIMIT_SEARCH_PER_MINUTE=60
# Per source IP: inbound server-to-server calls (Keycloak back-channel logout, Jira and GitHub webhooks),
# kept separate from browser traffic.
RATE_LIMIT_WEBHOOK_PER_MINUTE=600

# --- Worker: outbox relay and queues (ARCHITECTURE §3) ---------------------------------------------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=10
JOB_MAX_ATTEMPTS=5

# --- Development seed (ROADMAP P1-4) ---------------------------------------------------------------
# `pnpm db:seed` refuses to run unless this is true and NODE_ENV is not production.
ALLOW_DEMO_SEED=true

# --- PostgreSQL (docker compose: postgres) ---------------------------------------------------------
# Host port published by the container. If another PostgreSQL already uses 5432 on this machine,
# change it here AND in DATABASE_URL / DATABASE_MIGRATION_URL below.
POSTGRES_HOST_PORT=5432
# Superuser of the dev container. Used only by the container and its init script.
POSTGRES_PASSWORD=__SECRET:POSTGRES_PASSWORD__
# Application role (runtime) and migration role (Prisma CLI), created by infra/docker/postgres/init.
OPS_APP_DB_PASSWORD=__SECRET:OPS_APP_DB_PASSWORD__
OPS_MIGRATOR_DB_PASSWORD=__SECRET:OPS_MIGRATOR_DB_PASSWORD__
DATABASE_URL=postgresql://ops_app:__SECRET:OPS_APP_DB_PASSWORD__@localhost:5432/company_ops
DATABASE_MIGRATION_URL=postgresql://ops_migrator:__SECRET:OPS_MIGRATOR_DB_PASSWORD__@localhost:5432/company_ops

# --- Redis (docker compose: redis) -----------------------------------------------------------------
REDIS_PASSWORD=__SECRET:REDIS_PASSWORD__
REDIS_URL=redis://:__SECRET:REDIS_PASSWORD__@localhost:6379

# --- Keycloak (docker compose: keycloak) -----------------------------------------------------------
KEYCLOAK_DB_PASSWORD=__SECRET:KEYCLOAK_DB_PASSWORD__
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=__SECRET:KC_BOOTSTRAP_ADMIN_PASSWORD__

# --- S3-compatible object storage (docker compose: seaweedfs; ADR-0008) ----------------------------
S3_ENDPOINT=http://localhost:8333
# Endpoint the browser uses for pre-signed upload/download URLs (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Web app only: origin of S3_PUBLIC_ENDPOINT, allowed in the CSP (connect-src, img-src) for uploads and photos.
STORAGE_PUBLIC_ORIGIN=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=company-ops-dev
S3_ACCESS_KEY_ID=__SECRET:S3_ACCESS_KEY_ID__
S3_SECRET_ACCESS_KEY=__SECRET:S3_SECRET_ACCESS_KEY__
S3_FORCE_PATH_STYLE=true

# --- Email (worker; docker compose: mailpit) --------------------------------------------------------
# Leave SMTP_HOST empty to disable email (deliveries are recorded as SKIPPED). Production relays
# need SMTP_SECURE=true (port 465) or STARTTLS (enforced), plus SMTP_USER/SMTP_PASSWORD from secrets.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=ops-dev@localhost.test
SMTP_USER=
SMTP_PASSWORD=
# Worker: how often the SLA sweep evaluates open tickets (ms).
SLA_SWEEP_INTERVAL_MS=60000
# Worker: how often overdue approvals are reminded (ms, once per assignment).
REQUEST_SLA_SWEEP_INTERVAL_MS=300000
# Worker: how often open attendance days past their deadline are marked missing check-out (ms).
ATTENDANCE_SWEEP_INTERVAL_MS=900000
# Worker: how often tender, contract, guarantee and corporate document reminders and expiries run (ms).
COMMERCIAL_MONITOR_INTERVAL_MS=900000

# --- Jira Cloud (Phase 4; API and worker; docs/INTEGRATIONS.md) -------------------------------------
# OAuth 2.0 (3LO) app from developer.atlassian.com. Leave both empty to disable the integration.
# Callback URL to register on the app: <APP_PUBLIC_URL>/api/v1/integrations/jira/callback
# The secret comes from your secret store; never commit it.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# Override only to point at a local fake Jira in tests; production requires the Atlassian defaults.
# JIRA_AUTH_BASE_URL=https://auth.atlassian.com
# JIRA_API_BASE_URL=https://api.atlassian.com
# Worker: reconciliation cadence, deep (full id) check cadence and webhook refresh cadence (ms).
JIRA_RECONCILE_INTERVAL_MS=3600000
JIRA_DEEP_RECONCILE_INTERVAL_MS=604800000
JIRA_WEBHOOK_REFRESH_INTERVAL_MS=86400000

# --- GitHub App (Phase 5; API and worker; docs/INTEGRATIONS.md §2) ----------------------------------
# Each deployment registers its own GitHub App (template: infra/github/app-manifest.template.json).
# Leave GITHUB_APP_ID empty to disable the integration; otherwise the API needs all six values below
# and the worker needs the app id, client id and private key. Personal access tokens are never used.
# Prefer the *_FILE forms (path to a mounted secret file) for the private key and secrets; never commit
# them. An inline private key may use literal \n for line breaks.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_CLIENT_SECRET_FILE=/run/secrets/github_app_client_secret
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key.pem
GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
# Override only to point at a local fake GitHub in tests; production requires the GitHub.com defaults.
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_WEB_BASE_URL=https://github.com
# API: raw webhook body cap in bytes (GitHub caps payloads at 25 MB).
GITHUB_WEBHOOK_MAX_BYTES=5242880
# Worker: PR reconciliation cadence, installation refresh cadence (ms), closed-PR history window (days).
GITHUB_RECONCILE_INTERVAL_MS=1800000
GITHUB_INSTALLATION_SYNC_INTERVAL_MS=21600000
GITHUB_PR_HISTORY_DAYS=90

# --- Technical-record retention (worker; ADR-0020) --------------------------------------------------
# Purges run only for categories an organization admin configured; nothing is purged by default.
RETENTION_PURGE_INTERVAL_MS=86400000
RETENTION_PURGE_BATCH_SIZE=1000
